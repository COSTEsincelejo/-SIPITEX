# Copia a .env o define las mismas claves en el panel del hosting.
# No pegue secretos reales en el repositorio.

# --- PostgreSQL (docker-compose / local) ---
POSTGRES_USER=sipitex
POSTGRES_PASSWORD=sipitex
POSTGRES_DB=sipitex
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=sipitex;Username=sipitex;Password=sipitex

# --- Arranque / seed ---
# ASPNETCORE_ENVIRONMENT=Development
# SEED_DEMO_DATA=true          # solo demo; no usar en el entorno real del centro
# Seed__DemoUsers=false        # producción: sin usuarios demo
# ADMIN_SEED_PASSWORD=         # min. 6 caracteres; crea admin@sipitex.local si no hay Administrador

# --- Correo (producción: Brevo por HTTPS) ---
EMAIL_PROVIDER=Brevo
# Email__Provider=Brevo
EMAIL_API_KEY=
# Email__ApiKey=
EMAIL_FROM_ADDRESS=
# Email__FromAddress=
EMAIL_FROM_NAME=SIPITEX
# Email__FromName=SIPITEX
# Email__Enabled=true
# Email__Host=                 # solo si Email__Provider=Smtp; vacío o "configurar" = sin SMTP
# Email__Port=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# Email__User=
# Email__Password=

# --- App ---
# App__BaseUrl=https://su-dominio.ejemplo

# --- Soporte (Ayuda) ---
# Soporte__Responsable=Coordinación CMTC SENA
# Soporte__Correo=

# --- Seguridad ---
# Seguridad__MinutosInactividad=20

# --- Privacidad (vacío o PENDIENTE = no se publica; no inventar datos) ---
# Privacidad__Version=1.1
# Privacidad__FechaActualizacion=2026-11-06
# Privacidad__ResponsableNombre=
# Privacidad__NIT=
# Privacidad__Ciudad=
# Privacidad__CorreoContacto=
# Privacidad__Direccion=
# Privacidad__Telefono=
# Privacidad__HorarioAtencion=
# Privacidad__AreaSolicitudes=
# Privacidad__PlazoConservacion=
# Privacidad__ProveedorCorreo=
# Privacidad__PaisProveedorCorreo=
# Privacidad__ProveedorHosting=
# Privacidad__PaisProveedorHosting=
