@model ConsultarPlantasInventarioViewModel
@{
    ViewData["Title"] = "Inventario por bodega";
    ViewData["Breadcrumb"] = "SIPITEX / Operación / Inventario por bodega";
    Layout = "_Layout";
    var canManageCatalog = User.IsInRole("Administrador");
    var selected = Model.Plantas.FirstOrDefault(p => p.Id == Model.PlantaInventarioId);
    var nivelActual = Model.Nivel ?? "";
    var pagerExtra = new Dictionary<string, string?>
    {
        ["plantaInventarioId"] = Model.PlantaInventarioId?.ToString(),
        ["q"] = Model.Q,
        ["nivel"] = Model.Nivel
    };
}

<div class="page-header">
    <div>
        <h2>Inventario por bodega</h2>
        <div class="sub">Consulte los insumos y el stock de cada planta de inventario a su alcance.</div>
    </div>
    @if (canManageCatalog)
    {
        <div>
            <a class="ghost" asp-action="Index"><i class="fas fa-pen-to-square"></i> Administrar catálogo</a>
        </div>
    }
</div>

<div class="card">
    <div class="card-title"><i class="fas fa-warehouse"></i> Planta de inventario</div>
    <form asp-action="Consultar" method="get" class="form-row">
        <div class="field" style="min-width:240px;flex:1;">
            <label class="field-label" for="plantaInventarioId">Seleccione una planta</label>
            <select id="plantaInventarioId" name="plantaInventarioId" onchange="this.form.submit()">
                <option value="">Todas las plantas</option>
                @foreach (var p in Model.Plantas)
                {
                    if (Model.PlantaInventarioId == p.Id)
                    {
                        <option value="@p.Id" selected>@p.Nombre</option>
                    }
                    else
                    {
                        <option value="@p.Id">@p.Nombre</option>
                    }
                }
            </select>
        </div>
        <div class="field" style="align-self:flex-end;">
            <button type="submit" class="primary"><i class="fas fa-filter"></i> Ver</button>
        </div>
    </form>
    <div class="row-actions" style="flex-wrap:wrap;gap:8px;margin-top:12px;justify-content:flex-start;">
        <a class="@(Model.PlantaInventarioId is null ? "small primary" : "small ghost")" asp-action="Consultar">Todas</a>
        @foreach (var p in Model.Plantas)
        {
            <a class="@(Model.PlantaInventarioId == p.Id ? "small primary" : "small ghost")"
               asp-action="Consultar" asp-route-plantaInventarioId="@p.Id">@p.Nombre</a>
        }
    </div>
</div>

@if (Model.PlantaInventarioId is null)
{
    <div class="card">
        <div class="card-title teal"><i class="fas fa-layer-group"></i> Resumen por planta</div>
        @if (!Model.Resumen.Any())
        {
            <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-warehouse", Title = "Sin plantas de inventario", Text = "No hay plantas de inventario en su alcance.", ActionText = null }' />
        }
        else
        {
            <div class="table-wrap table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Planta</th>
                            <th>Insumos</th>
                            <th>Bajo</th>
                            <th>Crítico</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model.Resumen)
                    {
                        <tr>
                            <td><strong>@r.Nombre</strong></td>
                            <td>@r.Materiales</td>
                            <td>
                                @if (r.Bajo > 0)
                                {
                                    <span class="badge badge-warning">@r.Bajo</span>
                                }
                                else
                                {
                                    <span>0</span>
                                }
                            </td>
                            <td>
                                @if (r.Critico > 0)
                                {
                                    <span class="badge badge-danger">@r.Critico</span>
                                }
                                else
                                {
                                    <span>0</span>
                                }
                            </td>
                            <td>
                                <a class="small ghost" asp-action="Consultar" asp-route-plantaInventarioId="@r.Id">
                                    <i class="fas fa-boxes-stacked"></i> Ver inventario
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
else
{
    <div class="card" id="inventarioBodegaCard">
        <div class="card-title"><i class="fas fa-boxes-stacked"></i> Inventario@(selected is null ? "" : $" · {selected.Nombre}")</div>
        @if (Model.TotalSinFiltro == 0)
        {
            <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-boxes-stacked", Title = "Sin insumos", Text = "Esta bodega no tiene insumos registrados.", ActionText = null }' />
        }
        else
        {
            <form asp-action="Consultar" method="get" class="form-row" id="inventarioFiltrosForm">
                <input type="hidden" name="plantaInventarioId" value="@Model.PlantaInventarioId" />
                <div class="field" style="min-width:220px;flex:1;">
                    <label class="field-label" for="inventarioQ">Buscar insumo</label>
                    <input id="inventarioQ" name="q" type="search" value="@Model.Q" placeholder="Nombre del insumo" autocomplete="off" />
                </div>
                <div class="field" style="align-self:flex-end;">
                    <button type="submit" class="primary small"><i class="fas fa-magnifying-glass"></i> Buscar</button>
                </div>
                <div class="field" style="min-width:220px;">
                    <span class="field-label">Nivel de stock</span>
                    <div class="row-actions" style="justify-content:flex-start;gap:6px;">
                        <button type="submit" name="nivel" value="" class="small @(string.IsNullOrEmpty(nivelActual) ? "primary" : "ghost")" data-nivel="">Todos</button>
                        <button type="submit" name="nivel" value="@nameof(StockNivel.Bajo)" class="small @(string.Equals(nivelActual, nameof(StockNivel.Bajo), StringComparison.OrdinalIgnoreCase) ? "primary" : "ghost")" data-nivel="@nameof(StockNivel.Bajo)">Bajo</button>
                        <button type="submit" name="nivel" value="@nameof(StockNivel.Critico)" class="small @(string.Equals(nivelActual, nameof(StockNivel.Critico), StringComparison.OrdinalIgnoreCase) ? "primary" : "ghost")" data-nivel="@nameof(StockNivel.Critico)">Crítico</button>
                        <button type="submit" name="nivel" value="@InventarioConsultaFilter.Faltantes" class="small @(string.Equals(nivelActual, InventarioConsultaFilter.Faltantes, StringComparison.OrdinalIgnoreCase) ? "primary" : "ghost")" data-nivel="@InventarioConsultaFilter.Faltantes">Bajo y crítico</button>
                    </div>
                </div>
            </form>
            <div class="table-wrap table-responsive">
                <table id="inventarioBodegaTable">
                    <thead>
                        <tr>
                            <th>Insumo</th>
                            <th>Cantidad disponible</th>
                            <th>Unidad de medida</th>
                            <th>Nivel de stock</th>
                            <th>Costo promedio ponderado</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var mat in Model.Materials)
                    {
                        var nivel = StockNivelHelper.Classify(mat.Stock, mat.MinStock);
                        <tr data-name="@mat.Name" data-nivel="@nivel">
                            <td><strong>@mat.Name</strong></td>
                            <td>@mat.Stock.ToString("0.0")</td>
                            <td>@mat.UnitDisplay</td>
                            <td><span class="badge @DisplayHelper.BadgeClass(nivel)">@DisplayHelper.StatusText(nivel)</span></td>
                            <td>@mat.CostoPromedioPonderado.ToString("0.####")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalCount == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="fas fa-filter"></i></div>
                    <h3>Sin coincidencias</h3>
                    <p>Ningún insumo coincide con el nombre o el nivel de stock seleccionados.</p>
                </div>
            }
            <partial name="_Pager" model='new PagerModel { Action = "Consultar", Page = Model.Page, TotalPages = (int)Math.Ceiling(Model.TotalCount / (double)Math.Max(1, Model.PageSize)), TotalCount = Model.TotalCount, JumpInputId = "bodegaPage", Extra = pagerExtra }' />
        }
    </div>
}
