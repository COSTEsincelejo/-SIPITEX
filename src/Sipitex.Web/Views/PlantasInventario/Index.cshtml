@model InventarioPlantaViewModel
@{
    ViewData["Title"] = "Inventario por planta";
    ViewData["Breadcrumb"] = "SIPITEX / Operación / Inventario por planta";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h2>Inventario por planta</h2>
        <div class="sub">Consulte los insumos y el stock de cada planta de inventario a su alcance.</div>
    </div>
    @if (Model.PuedeAdministrarPlantas)
    {
        <div class="row-actions inventario-acciones">
            <button type="button" class="btn primary" data-open-gestion>
                <i class="fas fa-warehouse"></i> Administrar plantas
            </button>
            <a class="btn ghost" href="#gestion-plantas" data-open-gestion>
                <i class="fas fa-pen-to-square"></i> Administrar catálogo
            </a>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div data-toast data-toast-type="@(Model.IsSuccess ? "success" : "danger")" style="position:absolute;left:-9999px;">@Model.Message</div>
}

<div class="card">
    <div class="card-title"><i class="fas fa-warehouse"></i> Planta de inventario</div>
    <form asp-action="Index" method="get" class="form-row">
        <div class="field" style="min-width:240px;flex:1;">
            <label class="field-label" for="plantaId">Seleccione una planta</label>
            <select id="plantaId" name="plantaId" data-auto-submit>
                <option value="">Todas las plantas</option>
                @foreach (var p in Model.Plantas)
                {
                    if (Model.PlantaId == p.Id)
                    {
                        <option value="@p.Id" selected>@p.Nombre</option>
                    }
                    else
                    {
                        <option value="@p.Id">@p.Nombre</option>
                    }
                }
            </select>
        </div>
        <div class="field" style="align-self:flex-end;">
            <button type="submit" class="btn primary"><i class="fas fa-filter"></i> Ver</button>
        </div>
    </form>
    <div class="row-actions" style="flex-wrap:wrap;gap:8px;margin-top:12px;justify-content:flex-start;">
        <a class="btn small @(Model.PlantaId is null ? "primary" : "ghost")" asp-action="Index">Todas</a>
        @foreach (var p in Model.Plantas)
        {
            <a class="btn small @(Model.PlantaId == p.Id ? "primary" : "ghost")"
               asp-action="Index" asp-route-plantaId="@p.Id">@p.Nombre</a>
        }
    </div>
</div>

<partial name="_ResumenPlantas" model="Model" />
<partial name="_DetalleInventario" model="Model" />

@if (Model.PuedeAdministrarPlantas)
{
    <partial name="_GestionPlantas" model="Model" />
}
