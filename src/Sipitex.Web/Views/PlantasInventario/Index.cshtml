@model PlantasInventarioIndexViewModel
@{
    ViewData["Title"] = "Plantas de inventario";
    ViewData["Breadcrumb"] = "SIPITEX / Administración / Plantas de inventario";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h2>Plantas de inventario</h2>
        <div class="sub">Cree, renombre o elimine plantas de inventario. Planta de Inventario 1 y Planta de Inventario 2 vienen del sistema; puede agregar más. No se puede borrar una planta con materiales, solicitudes o encargados, ni la última planta de inventario, ni Planta de Inventario 1 (usada por defecto).</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div data-toast data-toast-type="@(Model.IsSuccess ? "success" : "danger")" style="position:absolute;left:-9999px;">@Model.Message</div>
}

<div class="card" style="max-width:560px;">
    <div class="card-title teal"><i class="fas fa-plus"></i> Nueva planta de inventario</div>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="form-row">
            <div class="field" style="flex:1;">
                <label class="field-label">Nombre</label>
                <input type="text" name="Form.Nombre" value="@Model.Form.Nombre" maxlength="80" required
                       placeholder="Ej. Planta de Inventario 3" />
            </div>
            <div class="field" style="align-self:flex-end;">
                <button type="submit" class="primary">Crear</button>
            </div>
        </div>
    </form>
</div>

<div class="card">
    <div class="card-title"><i class="fas fa-warehouse"></i> Catálogo</div>
    @if (!Model.PlantasInventario.Any())
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-warehouse", Title = "Sin plantas de inventario", Text = "No hay plantas de inventario registradas.", ActionText = null }' />
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Nombre</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var b in Model.PlantasInventario)
                {
                    <tr>
                        <td>@b.Id</td>
                        <td><strong>@b.Nombre</strong></td>
                        <td>
                            <div class="row-actions">
                                <a asp-action="Edit" asp-route-id="@b.Id" class="btn small ghost"><i class="fas fa-pen"></i> Editar</a>
                                <form asp-action="Delete" method="post" style="display:inline;"
                                      data-confirm="¿Eliminar «@b.Nombre»? Solo se permite si no tiene materiales, solicitudes ni encargados.">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@b.Id" />
                                    <button type="submit" class="small danger"><i class="fas fa-trash"></i> Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
