@model InventarioPlantaViewModel

<dialog id="gestion-plantas" class="gestion-dialog" aria-labelledby="gestion-plantas-titulo">
    <div class="gestion-dialog-head">
        <div>
            <h3 id="gestion-plantas-titulo">Administrar plantas</h3>
            <p class="sub">Cree, renombre o desactive plantas de inventario. Planta de Inventario 1 no se puede eliminar. Si hay stock, hay que reasignarlo a otra planta antes de desactivar.</p>
        </div>
        <button type="button" class="icon-btn" data-close-gestion aria-label="Cerrar">
            <i class="fas fa-xmark" aria-hidden="true"></i>
        </button>
    </div>
    <div class="gestion-dialog-body">
        <div class="card">
            <div class="card-title teal"><i class="fas fa-plus"></i> Nueva planta de inventario</div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="form-row">
                    <div class="field" style="flex:1;">
                        <label class="field-label" for="Nombre">Nombre</label>
                        <input type="text" id="Nombre" name="Form.Nombre" maxlength="80" required
                               placeholder="Ej. Planta de Inventario 3" />
                    </div>
                    <div class="field" style="align-self:flex-end;">
                        <button type="submit" class="btn primary">Crear</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="card">
            <div class="card-title"><i class="fas fa-warehouse"></i> Catálogo</div>
            @if (!Model.Plantas.Any())
            {
                <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-warehouse", Title = "Sin plantas de inventario", Text = "No hay plantas de inventario registradas.", ActionText = null }' />
            }
            else
            {
                <div class="table-wrap table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Nombre</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var b in Model.Plantas)
                        {
                            <tr>
                                <td>@b.Id</td>
                                <td><strong>@b.Nombre</strong></td>
                                <td>
                                    @if (b.Activo)
                                    {
                                        <span class="badge badge-success">Activa</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">Inactiva</span>
                                    }
                                </td>
                                <td>
                                    <div class="row-actions">
                                        <a asp-action="Detalle" asp-route-id="@b.Id" class="btn small ghost"><i class="fas fa-eye"></i> Operar inventario</a>
                                        <a asp-action="Edit" asp-route-id="@b.Id" class="btn small ghost"><i class="fas fa-pen"></i> Editar</a>
                                        @if (b.Activo)
                                        {
                                            <a asp-action="Delete" asp-route-id="@b.Id" class="btn small danger"><i class="fas fa-trash"></i> Desactivar</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</dialog>

<script>
    (function () {
        const dialog = document.getElementById('gestion-plantas');
        if (!dialog || typeof dialog.showModal !== 'function') return;

        function open() {
            if (!dialog.open) dialog.showModal();
            const nombre = document.getElementById('Nombre');
            if (location.hash === '#Nombre' && nombre) nombre.focus();
        }

        document.querySelectorAll('[data-open-gestion]').forEach(function (el) {
            el.addEventListener('click', function (event) {
                event.preventDefault();
                open();
            });
        });
        dialog.querySelectorAll('[data-close-gestion]').forEach(function (el) {
            el.addEventListener('click', function () { dialog.close(); });
        });

        if (location.hash === '#Nombre' || location.hash === '#gestion-plantas') open();
    })();
</script>
