@model InventarioPlantaViewModel
@{
    var puedeOperar = User.IsInRole(UserRoles.Administrador) || User.IsInRole(UserRoles.EncargadoDeBodega);
}

<div class="card">
    <div class="card-title teal"><i class="fas fa-layer-group"></i> Resumen por planta</div>
    @if (!Model.Resumen.Any())
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-warehouse", Title = "Sin plantas de inventario", Text = "No hay plantas de inventario en su alcance.", ActionText = null }' />
    }
    else
    {
        <div class="table-wrap table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>Planta</th>
                        <th>Insumos</th>
                        <th>OK</th>
                        <th>Bajo</th>
                        <th>Crítico</th>
                        <th>Sin mínimo</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Resumen)
                {
                    <tr>
                        <td><strong>@r.Nombre</strong></td>
                        <td>@r.Insumos</td>
                        <td>@r.Ok</td>
                        <td>
                            @if (r.Bajo > 0)
                            {
                                <span class="badge badge-warning">@r.Bajo</span>
                            }
                            else
                            {
                                <span>0</span>
                            }
                        </td>
                        <td>
                            @if (r.Critico > 0)
                            {
                                <span class="badge badge-danger">@r.Critico</span>
                            }
                            else
                            {
                                <span>0</span>
                            }
                        </td>
                        <td>
                            @if (r.SinMinimo > 0)
                            {
                                <span class="badge badge-neutral">@r.SinMinimo</span>
                            }
                            else
                            {
                                <span>0</span>
                            }
                        </td>
                        <td>
                            <div class="row-actions">
                                <a class="btn small primary" asp-action="Index" asp-route-plantaId="@r.Id">
                                    <i class="fas fa-boxes-stacked"></i> Ver inventario
                                </a>
                                @if (puedeOperar)
                                {
                                    <a class="btn small ghost" asp-action="Detalle" asp-route-id="@r.Id">
                                        <i class="fas fa-eye"></i> Operar inventario
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
                @if (Model.PlantaId is null && Model.Resumen.Count > 1)
                {
                    <tfoot>
                        <tr>
                            <th>Todas</th>
                            <th>@Model.Consolidado.Insumos</th>
                            <th>@Model.Consolidado.Ok</th>
                            <th>@Model.Consolidado.Bajo</th>
                            <th>@Model.Consolidado.Critico</th>
                            <th>@Model.Consolidado.SinMinimo</th>
                            <th></th>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    }
</div>
