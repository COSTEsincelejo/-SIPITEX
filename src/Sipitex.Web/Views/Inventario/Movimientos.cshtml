@model InventarioMovimientosViewModel
@{
    ViewData["Title"] = "Historial de movimientos";
    ViewData["Breadcrumb"] = "SIPITEX / Operación / Inventario / Movimientos";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h2>Historial de movimientos</h2>
        <div class="sub">Consulta entradas, salidas, ajustes y aprobaciones de stock</div>
    </div>
    <div>
        <a class="ghost" asp-action="Index"><i class="fas fa-arrow-left"></i> Volver a inventario</a>
    </div>
</div>

<div class="card">
    <form method="get" class="form-row" style="margin-bottom:1rem;">
        <div class="field">
            <label class="field-label">Desde</label>
            <input type="date" name="desde" value="@(Model.Desde?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="field">
            <label class="field-label">Hasta</label>
            <input type="date" name="hasta" value="@(Model.Hasta?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="field" style="min-width:200px;">
            <label class="field-label">Material</label>
                            <select name="materialId">
                <option value="">Todos</option>
                @foreach (var m in Model.Materials)
                {
                    if (Model.MaterialId == m.Id)
                    {
                        <option value="@m.Id" selected>@m.Name</option>
                    }
                    else
                    {
                        <option value="@m.Id">@m.Name</option>
                    }
                }
            </select>
        </div>
        <div class="field" style="align-self:flex-end;">
            <button type="submit" class="small"><i class="fas fa-filter"></i> Filtrar</button>
        </div>
    </form>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Fecha (UTC)</th>
                    <th>Usuario</th>
                    <th>Tipo</th>
                    <th>Origen</th>
                    <th>Material</th>
                    <th>Cantidad</th>
                    <th>Stock resultante</th>
                    <th>Referencia</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Movimientos.Count == 0)
            {
                <tr>
                    <td colspan="8"><span class="hint">No hay movimientos con los filtros seleccionados.</span></td>
                </tr>
            }
            @foreach (var mov in Model.Movimientos)
            {
                <tr>
                    <td>@mov.FechaUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@mov.UsuarioNombre</td>
                    <td><span class="badge @DisplayHelper.BadgeClass(mov.TipoMovimiento)">@DisplayHelper.Label(mov.TipoMovimiento)</span></td>
                    <td>@DisplayHelper.Label(mov.Origen)</td>
                    <td>@mov.MaterialName</td>
                    <td>@mov.Cantidad.ToString("0.##")</td>
                    <td>@mov.StockResultante.ToString("0.##")</td>
                    <td><span class="hint">@(mov.Referencia ?? "—")</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
