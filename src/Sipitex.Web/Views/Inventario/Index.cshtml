@model InventarioIndexViewModel
@{
    ViewData["Title"] = "Inventario";
    ViewData["Breadcrumb"] = "SIPITEX / Operación / Inventario";
    Layout = "_Layout";
    var lowStock = Model.Materials.Where(m => m.IsLowStock).Select(m => m.Name).ToList();
    var canManageStock = User.IsInRole("Administrador") || User.IsInRole("Bodeguero");
    var canRequest = User.IsInRole("Administrador") || User.IsInRole("Instructor");
}

<div class="page-header">
    <div>
        <h2>Inventario de materias primas</h2>
        <div class="sub">Controla niveles de stock, mínimos y solicitudes de bodega</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")">
        <i class="fas @(Model.IsSuccess ? "fa-circle-check" : "fa-triangle-exclamation")"></i>
        @Model.Message
    </div>
}

<div class="card">
    <div class="card-title"><i class="fas fa-warehouse"></i> Materias primas e insumos</div>
    @if (canManageStock)
    {
        <form asp-action="AddMaterial" method="post" class="form-row">
            @Html.AntiForgeryToken()
            <div class="field" style="flex:2;min-width:200px;">
                <label class="field-label">Material</label>
                <input asp-for="CreateMaterial.Name" placeholder="ej. Tela jersey" style="width:100%" required />
            </div>
            <div class="field" style="width:120px;">
                <label class="field-label">Stock inicial</label>
                <input asp-for="CreateMaterial.Stock" type="number" step="0.1" min="0" required />
            </div>
            <div class="field" style="width:120px;">
                <label class="field-label">Unidad</label>
                <select asp-for="CreateMaterial.Unit" asp-items="Html.GetEnumSelectList<MaterialUnit>()"></select>
            </div>
            <button type="submit" class="primary"><i class="fas fa-plus"></i> Agregar material</button>
        </form>
    }
    <div class="table-wrap">
        <table>
            <thead><tr><th>Material</th><th>Unidad</th><th>Stock</th><th>Estado</th><th>Última entrada</th><th>Mínimo</th><th></th></tr></thead>
            <tbody>
            @foreach (var mat in Model.Materials)
            {
                <tr>
                    <td><strong>@mat.Name</strong></td>
                    <td>@mat.UnitDisplay</td>
                    <td>@mat.Stock.ToString("0.0")</td>
                    <td>
                        @if (canManageStock)
                        {
                            <form asp-action="UpdateStatus" method="post" style="display:inline-flex;gap:6px;align-items:center;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="MaterialId" value="@mat.Id" />
                                <select name="Status" onchange="this.form.submit()">
                                    @foreach (MaterialStatus st in Enum.GetValues<MaterialStatus>())
                                    {
                                        if (st == mat.Status)
                                        {
                                            <option value="@st" selected>@st</option>
                                        }
                                        else
                                        {
                                            <option value="@st">@st</option>
                                        }
                                    }
                                </select>
                            </form>
                        }
                        else
                        {
                            <span class="badge @DisplayHelper.BadgeClass(mat.Status)">@mat.Status</span>
                        }
                    </td>
                    <td>@mat.LastEntryDate.ToString("yyyy-MM-dd")</td>
                    <td>@mat.MinStock</td>
                    <td>
                        @if (canManageStock)
                        {
                            <form asp-action="AdjustStock" method="post" style="display:inline-flex;gap:6px;align-items:center;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="MaterialId" value="@mat.Id" />
                                <input type="number" name="NewStock" value="@mat.Stock.ToString("0.##")" step="0.1" min="0" style="width:80px" />
                                <button type="submit" class="small ghost"><i class="fas fa-pen"></i> Ajustar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (lowStock.Any())
    {
        <div class="alert alert-warning" style="margin-top:14px;">
            <i class="fas fa-triangle-exclamation"></i> Alertas de stock mínimo: @string.Join(", ", lowStock)
        </div>
    }
    else
    {
        <div class="alert alert-success" style="margin-top:14px;">
            <i class="fas fa-circle-check"></i> Stock dentro de los niveles normales
        </div>
    }
</div>

<div class="card">
    <div class="card-title teal"><i class="fas fa-truck-ramp-box"></i> Solicitudes de material</div>
    @if (canRequest)
    {
        <form asp-action="CreateRequest" method="post" class="form-row">
            @Html.AntiForgeryToken()
            <div class="field">
                <label class="field-label">Orden</label>
                <select asp-for="CreateRequest.ProductionOrderId" asp-items="@(new SelectList(Model.Orders, "Id", "OrderNumber"))"></select>
            </div>
            <div class="field">
                <label class="field-label">Material</label>
                <select asp-for="CreateRequest.MaterialId">
                    @foreach (var m in Model.Materials)
                    {
                        <option value="@m.Id">@m.Name (stock: @m.Stock.ToString("0.0"))</option>
                    }
                </select>
            </div>
            <div class="field" style="width:120px;">
                <label class="field-label">Cantidad</label>
                <input asp-for="CreateRequest.Quantity" type="number" step="0.1" min="0.1" required />
            </div>
            <button type="submit" class="primary"><i class="fas fa-paper-plane"></i> Solicitar</button>
        </form>
    }
    <div class="table-wrap">
        <table>
            <thead><tr><th>Material</th><th>Cantidad</th><th>Orden</th><th>Estado</th><th></th></tr></thead>
            <tbody>
            @foreach (var req in Model.Requests)
            {
                <tr>
                    <td>@req.MaterialName</td>
                    <td>@req.Quantity</td>
                    <td>@req.OrderNumber</td>
                    <td><span class="badge @DisplayHelper.BadgeClass(req.Status)">@req.Status</span></td>
                    <td>
                        @if (req.Status == RequestStatus.Pendiente && canManageStock)
                        {
                            <form asp-action="ApproveRequest" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@req.Id" />
                                <button type="submit" class="small ghost"><i class="fas fa-check"></i> Aprobar</button>
                            </form>
                            <form asp-action="RejectRequest" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@req.Id" />
                                <button type="submit" class="small ghost"><i class="fas fa-xmark"></i> Rechazar</button>
                            </form>
                        }
                        else if (req.Status == RequestStatus.Aprobada)
                        {
                            <text>Despachado</text>
                        }
                        else if (req.Status == RequestStatus.Rechazada)
                        {
                            <text>Rechazada</text>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="alert alert-info" style="margin-top:14px;">
        <i class="fas fa-circle-info"></i> Instructor solicita · Bodeguero aprueba o rechaza. Al aprobar, el stock se descuenta automáticamente.
    </div>
</div>
