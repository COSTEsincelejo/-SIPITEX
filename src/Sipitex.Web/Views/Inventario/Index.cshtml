@model InventarioIndexViewModel
@{
    ViewData["Title"] = "Inventario";
    ViewData["Breadcrumb"] = "SIPITEX / Operación / Inventario";
    Layout = "_Layout";
    var canRequest = User.IsInRole("Administrador") || User.IsInRole("Instructor");
    var canRegister = Model.CanRegister;
    var canManage = Model.CanManage;
    string FilterClass(string key) => Model.Filter == key ? "filter-chip active" : "filter-chip";
}

<div class="page-header">
    <div>
        <h2>Inventario de productos</h2>
        <div class="sub">Lista organizada del stock: agotados, por agotarse y estado general de cada material</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div data-toast data-toast-type="@(Model.IsSuccess ? "success" : "danger")" class="visually-hidden">@Model.Message</div>
}

<div class="stock-summary">
    <a class="stock-stat" asp-action="Index" asp-route-filtro="todos">
        <span class="stock-stat-label">Total</span>
        <span class="stock-stat-value">@Model.Materials.Count</span>
    </a>
    <a class="stock-stat danger" asp-action="Index" asp-route-filtro="agotados">
        <span class="stock-stat-label">Agotados</span>
        <span class="stock-stat-value">@Model.DepletedCount</span>
    </a>
    <a class="stock-stat warning" asp-action="Index" asp-route-filtro="por-agotarse">
        <span class="stock-stat-label">Por agotarse</span>
        <span class="stock-stat-value">@Model.LowStockCount</span>
    </a>
    <a class="stock-stat success" asp-action="Index" asp-route-filtro="normal">
        <span class="stock-stat-label">Normal</span>
        <span class="stock-stat-value">@Model.NormalCount</span>
    </a>
</div>

<div class="card">
    <div class="card-title"><i class="fas fa-list"></i> Lista de productos</div>

    <div class="filter-bar">
        <a class="@FilterClass("todos")" asp-action="Index" asp-route-filtro="todos">Todos</a>
        <a class="@FilterClass("agotados")" asp-action="Index" asp-route-filtro="agotados">Agotados</a>
        <a class="@FilterClass("por-agotarse")" asp-action="Index" asp-route-filtro="por-agotarse">Por agotarse</a>
        <a class="@FilterClass("normal")" asp-action="Index" asp-route-filtro="normal">Normal</a>
    </div>

    @if (canRegister)
    {
        <div class="register-panel">
            <h3 class="register-title">Registrar producto</h3>
            <p class="register-hint">Solo bodeguero, administrador o instructor con permiso otorgado por el administrador.</p>
            <form asp-action="AddMaterial" method="post" class="form-row">
                @Html.AntiForgeryToken()
                <div class="field" style="flex:2;min-width:200px;">
                    <label class="field-label">Producto / material</label>
                    <input asp-for="CreateMaterial.Name" placeholder="ej. Tela jersey" style="width:100%" required />
                </div>
                <div class="field" style="width:120px;">
                    <label class="field-label">Stock inicial</label>
                    <input asp-for="CreateMaterial.Stock" type="number" step="0.1" min="0" required />
                </div>
                <div class="field" style="width:120px;">
                    <label class="field-label">Mínimo</label>
                    <input asp-for="CreateMaterial.MinStock" type="number" step="0.1" min="0.1" required />
                </div>
                <div class="field" style="width:120px;">
                    <label class="field-label">Unidad</label>
                    <select asp-for="CreateMaterial.Unit" asp-items="Html.GetEnumSelectList<MaterialUnit>()"></select>
                </div>
                <button type="submit" class="primary"><i class="fas fa-plus"></i> Registrar</button>
            </form>
        </div>
    }

    @if (!Model.FilteredMaterials.Any())
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-boxes-stacked", Title = "Sin productos en este filtro", Text = "No hay materiales que coincidan con la vista seleccionada.", ActionText = canRegister ? "Registre un producto con el formulario de arriba." : null }' />
    }
    else
    {
        <div class="product-list">
            @foreach (var mat in Model.FilteredMaterials)
            {
                <article class="product-row">
                    <div class="product-main">
                        <div class="product-name">@mat.Name</div>
                        <div class="product-meta">
                            <span>@mat.UnitDisplay</span>
                            <span>·</span>
                            <span>Mín. @mat.MinStock.ToString("0.##")</span>
                            <span>·</span>
                            <span>Última entrada @mat.LastEntryDate.ToString("yyyy-MM-dd")</span>
                        </div>
                    </div>
                    <div class="product-stock">
                        <div class="product-stock-value">@mat.Stock.ToString("0.##")</div>
                        <span class="badge @mat.StockLevelBadge">@mat.StockLevel</span>
                    </div>
                    <div class="product-condition">
                        @if (canManage)
                        {
                            <form asp-action="UpdateStatus" method="post" class="row-actions">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="MaterialId" value="@mat.Id" />
                                <select name="Status" onchange="this.form.submit()" aria-label="Estado físico">
                                    @foreach (MaterialStatus st in Enum.GetValues<MaterialStatus>())
                                    {
                                        if (st == mat.Status)
                                        {
                                            <option value="@st" selected>@DisplayHelper.StatusText(st)</option>
                                        }
                                        else
                                        {
                                            <option value="@st">@DisplayHelper.StatusText(st)</option>
                                        }
                                    }
                                </select>
                            </form>
                        }
                        else
                        {
                            <span class="badge @DisplayHelper.BadgeClass(mat.Status)">@DisplayHelper.StatusText(mat.Status)</span>
                        }
                    </div>
                    <div class="product-actions">
                        @if (canManage)
                        {
                            <form asp-action="AdjustStock" method="post" class="row-actions">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="MaterialId" value="@mat.Id" />
                                <input type="number" name="NewStock" value="@mat.Stock.ToString("0.##")" step="0.1" min="0" style="width:88px" aria-label="Nuevo stock" />
                                <button type="submit" class="small ghost"><i class="fas fa-pen"></i> Ajustar</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
</div>

<div class="card">
    <div class="card-title teal"><i class="fas fa-truck-ramp-box"></i> Solicitudes de material</div>
    @if (canRequest)
    {
        <form asp-action="CreateRequest" method="post" class="form-row">
            @Html.AntiForgeryToken()
            <div class="field">
                <label class="field-label">Orden</label>
                <select asp-for="CreateRequest.ProductionOrderId" asp-items="@(new SelectList(Model.Orders, "Id", "OrderNumber"))"></select>
            </div>
            <div class="field">
                <label class="field-label">Material</label>
                <select asp-for="CreateRequest.MaterialId">
                    @foreach (var m in Model.Materials)
                    {
                        <option value="@m.Id">@m.Name (stock: @m.Stock.ToString("0.0") · @m.StockLevel)</option>
                    }
                </select>
            </div>
            <div class="field" style="width:120px;">
                <label class="field-label">Cantidad</label>
                <input asp-for="CreateRequest.Quantity" type="number" step="0.1" min="0.1" required />
            </div>
            <button type="submit" class="primary"><i class="fas fa-paper-plane"></i> Solicitar</button>
        </form>
    }
    @if (!Model.Requests.Any())
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-inbox", Title = "Sin solicitudes", Text = "Cuando un instructor solicite material, aparecerá aquí para aprobación de bodega.", ActionText = canRequest ? "Cree la primera solicitud con el formulario de arriba." : null }' />
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Material</th><th>Cantidad</th><th>Orden</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                @foreach (var req in Model.Requests)
                {
                    <tr>
                        <td>@req.MaterialName</td>
                        <td>@req.Quantity</td>
                        <td>@req.OrderNumber</td>
                        <td><span class="badge @DisplayHelper.BadgeClass(req.Status)">@DisplayHelper.StatusText(req.Status)</span></td>
                        <td>
                            <div class="row-actions">
                            @if (req.Status == RequestStatus.Pendiente && canManage)
                            {
                                <form asp-action="ApproveRequest" method="post" data-confirm="¿Aprobar esta solicitud y descontar stock?">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@req.Id" />
                                    <button type="submit" class="small ghost"><i class="fas fa-check"></i> Aprobar</button>
                                </form>
                                <form asp-action="RejectRequest" method="post" data-confirm="¿Rechazar esta solicitud?">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@req.Id" />
                                    <button type="submit" class="small danger"><i class="fas fa-xmark"></i> Rechazar</button>
                                </form>
                            }
                            else if (req.Status == RequestStatus.Aprobada)
                            {
                                <span class="badge badge-success">Despachado</span>
                            }
                            else if (req.Status == RequestStatus.Rechazada)
                            {
                                <span class="badge badge-danger">Rechazada</span>
                            }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    <div class="alert alert-info" style="margin-top:14px;">
        <i class="fas fa-circle-info"></i> Instructor solicita · Bodeguero/Admin aprueba. Registrar productos: bodeguero, administrador o instructor con permiso del administrador.
    </div>
</div>
