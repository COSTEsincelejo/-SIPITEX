@* Modelo con materiales, solicitudes y formularios de creación *@
@model InventarioIndexViewModel
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Inventario";
    ViewData["Breadcrumb"] = "SIPITEX / Operación / Inventario";
    Layout = "_Layout";
    // Materiales con stock bajo para el banner de alerta
    var lowStock = Model.Materials.Where(m => m.IsLowStock).Select(m => m.Name).ToList();
    var canManageStock = User.IsInRole("Administrador") || User.IsInRole("Bodeguero");
    // Políticas más finas que el rol (permisos extendidos)
    var canRegisterMaterial = (await AuthorizationService.AuthorizeAsync(User, resource: null, Sipitex.Application.Authorization.AuthorizationPolicyNames.PuedeRegistrarMateriales)).Succeeded;
    var canApproveRequests = (await AuthorizationService.AuthorizeAsync(User, resource: null, Sipitex.Application.Authorization.AuthorizationPolicyNames.PuedeAprobarSolicitudes)).Succeeded;
    var canRequest = User.IsInRole("Administrador");
}

<div class="page-header">
    <div>
        <h2>Inventario de materias primas</h2>
        <div class="sub">Controla niveles de stock, mínimos y solicitudes de bodega</div>
    </div>
    @if (canManageStock)
    {
        <div>
            <a class="ghost" asp-action="Movimientos"><i class="fas fa-clock-rotate-left"></i> Historial de movimientos</a>
        </div>
    }
</div>

@* Toast después de crear material, aprobar solicitud, etc. *@
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div data-toast data-toast-type="@(Model.IsSuccess ? "success" : "danger")" style="position:absolute;left:-9999px;">@Model.Message</div>
}

<div class="card">
    <div class="card-title"><i class="fas fa-warehouse"></i> Materias primas e insumos</div>
    @{
        var bodegas = ViewBag.Bodegas as IEnumerable<Bodega> ?? Array.Empty<Bodega>();
        var actorBodegaId = ViewBag.ActorBodegaId as int?;
        var filterBodegaId = ViewBag.FilterBodegaId as int?;
        var isAdmin = User.IsInRole("Administrador");
        var isBodeguero = User.IsInRole("Bodeguero");
        var actorBodega = actorBodegaId is int aid ? bodegas.FirstOrDefault(b => b.Id == aid) : null;
    }
    @if (isAdmin)
    {
        <form method="get" class="form-row" style="margin-bottom:14px;">
            <div class="field" style="min-width:220px;">
                <label class="field-label">Bodega</label>
                <select name="bodegaId" onchange="this.form.submit()" aria-label="Filtro de bodega">
                    <option value="">Todas las bodegas</option>
                    @foreach (var bodega in bodegas)
                    {
                        if (filterBodegaId == bodega.Id)
                        {
                            <option value="@bodega.Id" selected>@bodega.Nombre</option>
                        }
                        else
                        {
                            <option value="@bodega.Id">@bodega.Nombre</option>
                        }
                    }
                </select>
            </div>
        </form>
    }
    @if (canRegisterMaterial)
    {
        <form asp-action="AddMaterial" method="post" class="form-row">
            @Html.AntiForgeryToken()
            <div class="field" style="flex:2;min-width:200px;">
                <label class="field-label">Material</label>
                <input asp-for="CreateMaterial.Name" placeholder="ej. Tela jersey" style="width:100%" required />
            </div>
            <div class="field" style="width:120px;">
                <label class="field-label">Stock inicial</label>
                <input asp-for="CreateMaterial.Stock" type="number" step="0.1" min="0" required />
            </div>
            <div class="field" style="width:120px;">
                <label class="field-label">Unidad</label>
                <select asp-for="CreateMaterial.Unit" asp-items="Html.GetEnumSelectList<MaterialUnit>()"></select>
            </div>
            <div class="field" style="min-width:180px;">
                <label class="field-label">Origen de entrada</label>
                <select asp-for="CreateMaterial.Origen" required>
                    <option value="@StockEntryOrigin.Compra">Compra</option>
                    <option value="@StockEntryOrigin.Devolucion">Devolución</option>
                    <option value="@StockEntryOrigin.OtraFuenteAutorizada">Otra fuente autorizada</option>
                </select>
            </div>
            <div class="field" style="min-width:180px;">
                <label class="field-label">Bodega</label>
                @if (isBodeguero && actorBodegaId is not null)
                {
                    <select disabled aria-label="Bodega">
                        <option selected>@(actorBodega?.Nombre ?? "Bodega asignada")</option>
                    </select>
                    <input type="hidden" name="CreateMaterial.BodegaId" value="@actorBodegaId" />
                }
                else
                {
                    <select asp-for="CreateMaterial.BodegaId" required>
                        <option value="">— Seleccione —</option>
                        @foreach (var bodega in bodegas)
                        {
                            <option value="@bodega.Id">@bodega.Nombre</option>
                        }
                    </select>
                }
            </div>
            <button type="submit" class="primary"><i class="fas fa-plus"></i> Agregar material</button>
        </form>
    }
    @if (!Model.Materials.Any())
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-boxes-stacked", Title = "Sin materiales", Text = "Todavía no hay materias primas registradas.", ActionText = canRegisterMaterial ? "Use el formulario superior para agregar el primero." : null }' />
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Material</th><th>Unidad</th><th>Stock</th><th>Bodega</th><th>Estado</th><th>Última entrada</th><th>Mínimo</th><th></th></tr></thead>
                <tbody>
                @foreach (var mat in Model.Materials)
                {
                    <tr>
                        <td><strong>@mat.Name</strong></td>
                        <td>@mat.UnitDisplay</td>
                        <td>@mat.Stock.ToString("0.0")</td>
                        <td>@mat.BodegaNombre</td>
                        <td>
                            @if (canManageStock)
                            {
                                @* Bodeguero puede cambiar estado con un select que hace submit al cambiar *@
                                <form asp-action="UpdateStatus" method="post" class="row-actions">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="MaterialId" value="@mat.Id" />
                                    <select name="Status" onchange="this.form.submit()" aria-label="Estado del material">
                                        @foreach (MaterialStatus st in Enum.GetValues<MaterialStatus>())
                                        {
                                            if (st == mat.Status)
                                            {
                                                <option value="@st" selected>@DisplayHelper.StatusText(st)</option>
                                            }
                                            else
                                            {
                                                <option value="@st">@DisplayHelper.StatusText(st)</option>
                                            }
                                        }
                                    </select>
                                </form>
                            }
                            else
                            {
                                <span class="badge @DisplayHelper.BadgeClass(mat.Status)">@DisplayHelper.StatusText(mat.Status)</span>
                            }
                        </td>
                        <td>@mat.LastEntryDate.ToString("yyyy-MM-dd")</td>
                        <td>@mat.MinStock</td>
                        <td>
                            @if (User.IsInRole("Administrador"))
                            {
                                <form asp-action="EditMaterial" method="post" class="row-actions" style="flex-wrap:wrap;gap:6px;margin-bottom:6px;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="MaterialId" value="@mat.Id" />
                                    <input type="text" name="Name" value="@mat.Name" required style="width:140px" aria-label="Nombre" />
                                    <select name="Unit" aria-label="Unidad">
                                        @foreach (MaterialUnit u in Enum.GetValues<MaterialUnit>())
                                        {
                                            if (u == mat.Unit)
                                            {
                                                <option value="@u" selected>@u</option>
                                            }
                                            else
                                            {
                                                <option value="@u">@u</option>
                                            }
                                        }
                                    </select>
                                    <input type="number" name="MinStock" value="@mat.MinStock.ToString("0.##")" step="0.1" min="0" style="width:72px" aria-label="Stock mínimo" />
                                    <button type="submit" class="small ghost"><i class="fas fa-floppy-disk"></i> Guardar</button>
                                </form>
                            }
                            @if (canManageStock)
                            {
                                <form asp-action="AdjustStock" method="post" class="row-actions" style="flex-wrap:wrap;gap:6px;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="MaterialId" value="@mat.Id" />
                                    <input type="number" name="NewStock" value="@mat.Stock.ToString("0.##")" step="0.1" min="0" style="width:88px" aria-label="Nuevo stock" />
                                    <select name="Origen" aria-label="Origen si aumenta stock">
                                        <option value="">Origen (si sube)</option>
                                        <option value="@StockEntryOrigin.Compra">Compra</option>
                                        <option value="@StockEntryOrigin.Devolucion">Devolución</option>
                                        <option value="@StockEntryOrigin.OtraFuenteAutorizada">Otra fuente autorizada</option>
                                    </select>
                                    <button type="submit" class="small ghost"><i class="fas fa-pen"></i> Ajustar</button>
                                </form>
                            }
                            @if (User.IsInRole("Administrador"))
                            {
                                <form asp-action="DeleteMaterial" method="post" class="row-actions" style="margin-top:4px;"
                                      onsubmit="return confirm('¿Eliminar «@mat.Name» del catálogo?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@mat.Id" />
                                    <button type="submit" class="small ghost danger"><i class="fas fa-trash"></i> Eliminar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (lowStock.Any())
        {
            <div class="alert alert-warning" style="margin-top:14px;">
                <i class="fas fa-triangle-exclamation"></i> Alertas de stock mínimo: @string.Join(", ", lowStock)
            </div>
        }
        else
        {
            <div class="alert alert-success" style="margin-top:14px;">
                <i class="fas fa-circle-check"></i> Stock dentro de los niveles normales
            </div>
        }
    }
</div>

<div class="card">
    <div class="card-title teal"><i class="fas fa-truck-ramp-box"></i> Solicitudes de material</div>
    @if (canRequest)
    {
        <form asp-action="CreateRequest" method="post" class="form-row">
            @Html.AntiForgeryToken()
            <div class="field">
                <label class="field-label">Orden</label>
                <select asp-for="CreateRequest.ProductionOrderId" asp-items="@(new SelectList(Model.Orders, "Id", "OrderNumber"))"></select>
            </div>
            <div class="field">
                <label class="field-label">Material</label>
                <select asp-for="CreateRequest.MaterialId">
                    @foreach (var m in Model.Materials)
                    {
                        <option value="@m.Id">@m.Name (stock: @m.Stock.ToString("0.0"))</option>
                    }
                </select>
            </div>
            <div class="field" style="width:120px;">
                <label class="field-label">Cantidad</label>
                <input asp-for="CreateRequest.Quantity" type="number" step="0.1" min="0.1" required />
            </div>
            <button type="submit" class="primary"><i class="fas fa-paper-plane"></i> Solicitar</button>
        </form>
    }
    @if (!Model.Requests.Any())
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-inbox", Title = "Sin solicitudes", Text = "Cuando un instructor solicite material, aparecerá aquí para aprobación de bodega.", ActionText = canRequest ? "Cree la primera solicitud con el formulario de arriba." : null }' />
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Material</th><th>Cantidad</th><th>Orden</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                @foreach (var req in Model.Requests)
                {
                    <tr>
                        <td>@req.MaterialName</td>
                        <td>@req.Quantity</td>
                        <td>@req.OrderNumber</td>
                        <td><span class="badge @DisplayHelper.BadgeClass(req.Status)">@DisplayHelper.StatusText(req.Status)</span></td>
                        <td>
                            <div class="row-actions">
                            @* Solo pendientes se pueden aprobar/rechazar *@
                            @if (req.Status == RequestStatus.Pendiente && canApproveRequests)
                            {
                                <form asp-action="ApproveRequest" method="post" data-confirm="¿Aprobar esta solicitud y descontar stock?">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@req.Id" />
                                    <button type="submit" class="small ghost"><i class="fas fa-check"></i> Aprobar</button>
                                </form>
                                <form asp-action="RejectRequest" method="post" data-confirm="¿Rechazar esta solicitud?">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@req.Id" />
                                    <button type="submit" class="small danger"><i class="fas fa-xmark"></i> Rechazar</button>
                                </form>
                            }
                            else if (req.Status == RequestStatus.Aprobada)
                            {
                                <span class="badge badge-success">Despachado</span>
                            }
                            else if (req.Status == RequestStatus.Rechazada)
                            {
                                <span class="badge badge-danger">Rechazada</span>
                            }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    <div class="alert alert-info" style="margin-top:14px;">
        <i class="fas fa-circle-info"></i> Admin solicita · Bodeguero aprueba o rechaza. Al aprobar, el stock se descuenta automáticamente.
    </div>
</div>
