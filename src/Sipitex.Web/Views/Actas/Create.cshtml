@model ActaCreateViewModel
@{
    ViewData["Title"] = "Nueva acta";
    ViewData["Breadcrumb"] = "SIPITEX / Operación / Actas / Nueva";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h2>Nueva acta</h2>
        <p class="hint">Origen Manual registra un ítem con las observaciones (o un texto por defecto). Stock exige marcar movimientos de su planta. Consumo usa los de la orden.</p>
    </div>
    <div>
        <a class="ghost" asp-action="Index"><i class="fas fa-arrow-left"></i> Volver</a>
    </div>
</div>

<div class="card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="form-row">
            <div class="field">
                <label class="field-label">Tipo</label>
                <select asp-for="Form.Tipo" asp-items="Html.GetEnumSelectList<ActaTipo>()"></select>
            </div>
            <div class="field">
                <label class="field-label">Origen</label>
                <select asp-for="Form.Origen" asp-items="Html.GetEnumSelectList<ActaOrigen>()"></select>
            </div>
            <div class="field">
                <label class="field-label">Orden</label>
                <select asp-for="Form.ProductionOrderId"
                        asp-items="@(new SelectList(Model.Orders, "Id", "OrderNumber", Model.Form.ProductionOrderId))"
                        onchange="window.location='@Url.Action("Create")?orderId=' + this.value">
                    <option value="">—</option>
                </select>
                <p class="hint">Al cambiar la orden se recargan los consumos asociados.</p>
            </div>
        </div>

        <div class="form-row">
            <div class="field">
                <label class="field-label">Estado origen (si es transición)</label>
                <select asp-for="Form.EstadoOrigen" asp-items="Html.GetEnumSelectList<EstadoProducto>()"></select>
            </div>
            <div class="field">
                <label class="field-label">Estado destino</label>
                <select asp-for="Form.EstadoDestino" asp-items="Html.GetEnumSelectList<EstadoProducto>()"></select>
            </div>
        </div>

        <div class="card-title"><i class="fas fa-boxes-stacked"></i> Movimientos de stock (origen Stock)</div>
        <div class="table-wrap" style="max-height:240px;overflow:auto;">
            <table>
                <thead>
                    <tr>
                        <th></th>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Material</th>
                        <th>Cantidad</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var m in Model.Movimientos.Take(40))
                {
                    <tr>
                        <td><input type="checkbox" name="Form.StockMovementIds" value="@m.Id" /></td>
                        <td>@m.FechaUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@DisplayHelper.Label(m.TipoMovimiento)</td>
                        <td>@m.MaterialName</td>
                        <td>@m.Cantidad.ToString("0.##")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="card-title"><i class="fas fa-scissors"></i> Consumos de la orden (origen Consumo)</div>
        <p class="hint">Si no marcas ninguno, se incluyen todos los consumos de la orden seleccionada.</p>
        <div class="table-wrap" style="max-height:240px;overflow:auto;">
            <table>
                <thead>
                    <tr>
                        <th></th>
                        <th>Material</th>
                        <th>Cantidad</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model.Consumos)
                {
                    <tr>
                        <td><input type="checkbox" name="Form.ConsumoIds" value="@c.Id" /></td>
                        <td>@c.MaterialName</td>
                        <td>@c.Cantidad.ToString("0.##")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="card-title"><i class="fas fa-file-signature"></i> Conformidad</div>
        <div class="form-row">
            <div class="field">
                <label class="field-label">Quien entrega</label>
                <input asp-for="Form.EntregaNombre" required />
            </div>
            <div class="field">
                <label class="field-label">Cargo</label>
                <input asp-for="Form.EntregaCargo" />
            </div>
            <div class="field" style="align-self:flex-end;">
                <label><input asp-for="Form.EntregaConforme" /> Conforme</label>
            </div>
        </div>
        <div class="form-row">
            <div class="field">
                <label class="field-label">Quien recibe</label>
                <input asp-for="Form.RecibeNombre" required />
            </div>
            <div class="field">
                <label class="field-label">Cargo</label>
                <input asp-for="Form.RecibeCargo" />
            </div>
            <div class="field" style="align-self:flex-end;">
                <label><input asp-for="Form.RecibeConforme" /> Conforme</label>
            </div>
        </div>
        <div class="field">
            <label class="field-label">Observaciones</label>
            <textarea asp-for="Form.Observaciones" rows="2"></textarea>
        </div>
        <button type="submit" class="primary">Registrar acta</button>
    </form>
</div>
