@model ActaCreateViewModel
@{
    ViewData["Title"] = "Nueva acta";
    ViewData["Breadcrumb"] = "SIPITEX / Operación / Actas / Nueva";
    Layout = "_Layout";
    var tipos = Model.Movimientos.Select(m => m.TipoMovimiento).Distinct().ToList();
}

<div class="page-header">
    <div>
        <h2>Nueva acta</h2>
        <p class="hint">Origen Manual registra un ítem con las observaciones (o un texto por defecto). Stock exige marcar movimientos y las plantas de origen y destino. La firma de quien entrega es obligatoria. Si quien recibe no firma, el acta queda pendiente de firma.</p>
    </div>
    <div>
        <a class="ghost" asp-action="Index"><i class="fas fa-arrow-left"></i> Volver</a>
    </div>
</div>

<div class="card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="form-row">
            <div class="field">
                <label class="field-label">Tipo</label>
                <select asp-for="Form.Tipo" asp-items="Html.GetEnumSelectList<ActaTipo>()"></select>
            </div>
            <div class="field">
                <label class="field-label">Origen</label>
                <select asp-for="Form.Origen" asp-items="Html.GetEnumSelectList<ActaOrigen>()"></select>
            </div>
            <div class="field">
                <label class="field-label">Orden</label>
                <select asp-for="Form.ProductionOrderId"
                        asp-items="@(new SelectList(Model.Orders, "Id", "OrderNumber", Model.Form.ProductionOrderId))">
                    <option value="">—</option>
                </select>
                <p class="hint">Al cambiar la orden se recargan los consumos asociados.</p>
            </div>
        </div>

        <div class="form-row">
            <div class="field">
                <label class="field-label" asp-for="Form.PlantaOrigenId">Planta origen</label>
                <select asp-for="Form.PlantaOrigenId" required="@(Model.Form.Origen == ActaOrigen.Stock ? "required" : null)">
                    <option value="">—</option>
                    @foreach (var planta in Model.PlantasActivas)
                    {
                        <option value="@planta.Id">@planta.Nombre</option>
                    }
                </select>
                <span asp-validation-for="Form.PlantaOrigenId" class="field-error"></span>
            </div>
            <div class="field">
                <label class="field-label" asp-for="Form.PlantaDestinoId">Planta destino</label>
                <select asp-for="Form.PlantaDestinoId" required="@(Model.Form.Origen == ActaOrigen.Stock ? "required" : null)">
                    <option value="">—</option>
                    @foreach (var planta in Model.PlantasActivas)
                    {
                        <option value="@planta.Id">@planta.Nombre</option>
                    }
                </select>
                <span asp-validation-for="Form.PlantaDestinoId" class="field-error"></span>
                <p class="hint">Obligatorias cuando el origen es movimientos de stock. En los demás orígenes son opcionales y solo se listan plantas activas.</p>
            </div>
        </div>

        @if (Model.Form.Origen == ActaOrigen.EstadoProducto)
        {
            <div class="form-row" id="actaEstados">
                <div class="field">
                    <label class="field-label">Estado origen</label>
                    <select asp-for="Form.EstadoOrigen">
                        @foreach (var estado in Enum.GetValues<EstadoProducto>())
                        {
                            <option value="@estado">@DisplayHelper.StatusText(estado)</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label class="field-label">Estado destino</label>
                    <select asp-for="Form.EstadoDestino">
                        @foreach (var estado in Enum.GetValues<EstadoProducto>())
                        {
                            <option value="@estado">@DisplayHelper.StatusText(estado)</option>
                        }
                    </select>
                </div>
            </div>
        }

        <div class="card-title"><i class="fas fa-boxes-stacked"></i> Movimientos de stock (origen Stock)</div>
        <div class="acta-filtros form-row">
            <div class="field" style="flex:1;min-width:180px;">
                <label class="field-label" for="actaBuscar">Buscar</label>
                <input type="search" id="actaBuscar" placeholder="Material, tipo o fecha" autocomplete="off" />
            </div>
            <div class="field">
                <label class="field-label" for="actaDesde">Desde</label>
                <input type="date" id="actaDesde" />
            </div>
            <div class="field">
                <label class="field-label" for="actaHasta">Hasta</label>
                <input type="date" id="actaHasta" />
            </div>
            <div class="field">
                <label class="field-label" for="actaTipo">Tipo</label>
                <select id="actaTipo">
                    <option value="">Todos</option>
                    @foreach (var tipo in tipos)
                    {
                        <option value="@tipo">@DisplayHelper.Label(tipo)</option>
                    }
                </select>
            </div>
        </div>
        <div class="acta-resumen">
            <label><input type="checkbox" id="actaSeleccionarVisibles" /> Seleccionar todos</label>
            <span id="actaResumen">Mostrando @Model.Movimientos.Count de @Model.Movimientos.Count · 0 seleccionados</span>
        </div>
        <div class="table-wrap table-responsive" style="max-height:280px;overflow:auto;">
            <table id="actaMovimientos">
                <thead>
                    <tr>
                        <th></th>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Material</th>
                        <th>Cantidad</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var m in Model.Movimientos)
                {
                    var ocupada = Model.ActasPorStock.TryGetValue(m.Id, out var actaStock);
                    var fecha = m.FechaUtc.ToString("yyyy-MM-dd");
                    var tipo = DisplayHelper.Label(m.TipoMovimiento);
                    var texto = $"{fecha} {m.FechaUtc:HH:mm} {tipo} {m.MaterialName} {m.Cantidad:0.##}";
                    if (ocupada)
                    {
                        texto += $" Ya en acta {actaStock}";
                    }
                    <tr data-fecha="@fecha" data-tipo="@m.TipoMovimiento" data-texto="@texto">
                        <td>
                            @if (ocupada)
                            {
                                <input type="checkbox" disabled aria-disabled="true" />
                            }
                            else
                            {
                                <input type="checkbox" name="Form.StockMovementIds" value="@m.Id" />
                            }
                        </td>
                        <td>@m.FechaUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@tipo</td>
                        <td>
                            @m.MaterialName
                            @if (ocupada)
                            {
                                <span class="badge badge-warning">Ya en acta @actaStock</span>
                            }
                        </td>
                        <td>@m.Cantidad.ToString("0.##")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="card-title"><i class="fas fa-scissors"></i> Consumos de la orden (origen Consumo)</div>
        <p class="hint">Si no marcas ninguno, se incluyen todos los consumos de la orden seleccionada.</p>
        @if (!Model.Consumos.Any())
        {
            <p>Esta orden no tiene consumos</p>
        }
        else
        {
            <div class="table-wrap table-responsive" style="max-height:240px;overflow:auto;">
                <table>
                    <thead>
                        <tr>
                            <th></th>
                            <th>Material</th>
                            <th>Cantidad</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var c in Model.Consumos)
                    {
                        var ocupado = Model.ActasPorConsumo.TryGetValue(c.Id, out var actaConsumo);
                        <tr>
                            <td>
                                @if (ocupado)
                                {
                                    <input type="checkbox" disabled aria-disabled="true" />
                                }
                                else
                                {
                                    <input type="checkbox" name="Form.ConsumoIds" value="@c.Id" />
                                }
                            </td>
                            <td>
                                @c.MaterialName
                                @if (ocupado)
                                {
                                    <span class="badge badge-warning">Ya en acta @actaConsumo</span>
                                }
                            </td>
                            <td>@c.Cantidad.ToString("0.##")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <div class="card-title"><i class="fas fa-file-signature"></i> Conformidad</div>
        <p class="hint">Si marca Conforme, debe dibujar la firma gráfica (mouse, lápiz o dedo). El nombre en texto no sustituye el trazo. La firma se guarda en PNG y se muestra al consultar o imprimir el PDF.</p>
        <div class="form-row">
            <div class="field">
                <label class="field-label" asp-for="Form.EntregaNombre">Quien entrega</label>
                <input asp-for="Form.EntregaNombre" />
                <span asp-validation-for="Form.EntregaNombre" class="field-error"></span>
            </div>
            <div class="field">
                <label class="field-label" asp-for="Form.EntregaCargo">Cargo</label>
                <input asp-for="Form.EntregaCargo" />
                <span asp-validation-for="Form.EntregaCargo" class="field-error"></span>
            </div>
            <div class="field" style="align-self:flex-end;">
                <label><input asp-for="Form.EntregaConforme" /> Conforme</label>
            </div>
        </div>
        <div class="signature-pad" data-signature-pad>
            <label class="field-label">Firma de quien entrega</label>
            <div class="signature-canvas-wrap">
                <canvas width="320" height="120" aria-label="Firme aquí (quien entrega)"></canvas>
                <span class="signature-hint" data-signature-hint>Firme aquí</span>
            </div>
            <input type="hidden" asp-for="Form.EntregaFirmaDataUrl" />
            <span asp-validation-for="Form.EntregaFirmaDataUrl" class="field-error"></span>
            <button type="button" class="ghost small" data-signature-clear>Limpiar firma</button>
        </div>
        <div class="form-row">
            <div class="field">
                <label class="field-label" asp-for="Form.RecibeNombre">Quien recibe</label>
                <input asp-for="Form.RecibeNombre" />
                <span asp-validation-for="Form.RecibeNombre" class="field-error"></span>
            </div>
            <div class="field">
                <label class="field-label" asp-for="Form.RecibeCargo">Cargo</label>
                <input asp-for="Form.RecibeCargo" />
                <span asp-validation-for="Form.RecibeCargo" class="field-error"></span>
            </div>
            <div class="field" style="align-self:flex-end;">
                <label><input asp-for="Form.RecibeConforme" /> Conforme</label>
            </div>
        </div>
        <div class="signature-pad" data-signature-pad>
            <label class="field-label">Firma de quien recibe (puede quedar pendiente)</label>
            <div class="signature-canvas-wrap">
                <canvas width="320" height="120" aria-label="Firme aquí (quien recibe)"></canvas>
                <span class="signature-hint" data-signature-hint>Firme aquí</span>
            </div>
            <input type="hidden" asp-for="Form.RecibeFirmaDataUrl" />
            <span asp-validation-for="Form.RecibeFirmaDataUrl" class="field-error"></span>
            <button type="button" class="ghost small" data-signature-clear>Limpiar firma</button>
        </div>
        <div class="field">
            <label class="field-label">Observaciones</label>
            <textarea asp-for="Form.Observaciones" rows="2"></textarea>
        </div>
        <div class="field">
            <label class="field-label" asp-for="Form.EnviarPdfCorreo">Enviar PDF por correo</label>
            <input asp-for="Form.EnviarPdfCorreo" type="email" autocomplete="email" placeholder="opcional" />
            <span asp-validation-for="Form.EnviarPdfCorreo" class="field-error"></span>
            <p class="hint">Opcional. Si lo indica, el PDF se envía al registrar el acta. El correo no se guarda.</p>
        </div>
        <button type="submit" class="primary">Registrar acta</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/signature-pad.js" asp-append-version="true"></script>
    <script src="~/js/actas-crear.js" asp-append-version="true"></script>
}
