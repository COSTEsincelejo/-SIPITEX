@model ActasIndexViewModel
@{
    ViewData["Title"] = "Actas de ingreso y egreso";
    ViewData["Breadcrumb"] = "SIPITEX / Operación / Actas";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h2>Actas de ingreso y egreso</h2>
        <div class="sub">Conformidad simple (nombre, cargo y timestamp). La firma gráfica queda pendiente de confirmar.</div>
    </div>
    <div>
        <a class="primary" asp-action="Create"><i class="fas fa-plus"></i> Nueva acta</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div data-toast data-toast-type="@(Model.IsSuccess ? "success" : "danger")" style="position:absolute;left:-9999px;">@Model.Message</div>
}

<div class="card">
    @if (Model.Actas.Count == 0)
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-file-signature", Title = "Sin actas", Text = "Todavía no hay actas de ingreso o egreso." }' />
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Número</th>
                        <th>Tipo</th>
                        <th>Origen</th>
                        <th>Fecha</th>
                        <th>Orden</th>
                        <th>Entrega</th>
                        <th>Recibe</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var a in Model.Actas)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@a.Id">@a.Numero</a></td>
                        <td><span class="badge @(a.Tipo == ActaTipo.Ingreso ? "badge-success" : "badge-warning")">@DisplayHelper.StatusText(a.Tipo)</span></td>
                        <td>@DisplayHelper.StatusText(a.Origen)</td>
                        <td>@a.FechaUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(a.OrderNumber ?? "—")</td>
                        <td>@a.EntregaNombre</td>
                        <td>@a.RecibeNombre</td>
                        <td>
                            <a class="small" asp-action="Details" asp-route-id="@a.Id">Ver</a>
                            <a class="small ghost" asp-action="Pdf" asp-route-id="@a.Id">PDF</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
