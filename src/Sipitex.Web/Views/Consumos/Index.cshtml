@model ConsumosIndexViewModel
@{
    ViewData["Title"] = "Consumo de materiales";
    ViewData["Breadcrumb"] = "SIPITEX / Operación / Consumo";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h2>Ficha de consumo de materiales</h2>
        <div class="sub">Registra cantidad utilizada, fecha y responsable. El costo usa el promedio ponderado por costo de adquisición.</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div data-toast data-toast-type="@(Model.IsSuccess ? "success" : "danger")" style="position:absolute;left:-9999px;">@Model.Message</div>
}

<div class="card">
    <div class="card-title"><i class="fas fa-plus"></i> Registrar consumo</div>
    <form asp-action="Create" method="post" class="form-row">
        @Html.AntiForgeryToken()
        <div class="field">
            <label class="field-label">Orden</label>
            <select asp-for="Form.ProductionOrderId" asp-items="@(new SelectList(Model.Orders, "Id", "OrderNumber"))"></select>
        </div>
        <div class="field">
            <label class="field-label">Material</label>
            <select asp-for="Form.MaterialId">
                @foreach (var m in Model.Materials)
                {
                    <option value="@m.Id">@m.Name (@m.UnitDisplay) · costo @m.CostoAdquisicion.ToString("0.####")</option>
                }
            </select>
        </div>
        <div class="field" style="width:140px;">
            <label class="field-label">Cantidad</label>
            <input asp-for="Form.Cantidad" type="number" step="0.01" min="0.01" required />
        </div>
        <div class="field">
            <label class="field-label">Fecha</label>
            <input asp-for="Form.FechaLocal" type="datetime-local" />
        </div>
        <button type="submit" class="primary">Registrar</button>
    </form>
</div>

<div class="card">
    <div class="card-title"><i class="fas fa-filter"></i> Consultar por orden</div>
    <form method="get" class="form-row">
        <div class="field">
            <label class="field-label">Orden</label>
            <select name="orderId" asp-items="@(new SelectList(Model.Orders, "Id", "OrderNumber", Model.Form.ProductionOrderId))"></select>
        </div>
        <div class="field" style="align-self:flex-end;">
            <button type="submit" class="small">Ver</button>
        </div>
    </form>
    @if (Model.Costo is not null)
    {
        <p>
            Cantidad total: <strong>@Model.Costo.CantidadTotal.ToString("0.####")</strong>
            · Costo promedio ponderado: <strong>@Model.Costo.CostoPromedioPonderado.ToString("0.####")</strong>
            · Costo total: <strong>@Model.Costo.CostoTotal.ToString("0.####")</strong>
        </p>
    }
    @if (!Model.Consumos.Any())
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-scissors", Title = "Sin consumos", Text = "Todavía no hay consumos registrados para esta orden." }' />
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Material</th>
                        <th>Cantidad</th>
                        <th>Costo unitario</th>
                        <th>Costo</th>
                        <th>Responsable</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model.Consumos)
                {
                    <tr>
                        <td>@c.FechaUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@c.MaterialCode @c.MaterialName</td>
                        <td>@c.Cantidad.ToString("0.####") @c.UnitDisplay</td>
                        <td>@c.CostoUnitario.ToString("0.####")</td>
                        <td>@c.CostoTotal.ToString("0.####")</td>
                        <td>@c.ResponsableNombre</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
