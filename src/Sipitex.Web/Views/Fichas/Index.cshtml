@using System.Security.Claims
@model FichasIndexViewModel
@{
    ViewData["Title"] = "Fichas & producción";
    ViewData["Breadcrumb"] = "SIPITEX / Operación / Fichas & producción";
    Layout = "_Layout";
    var instructorOptions = Model.Instructors;
    int? currentUserId = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var uid) ? uid : null;
    var isAdmin = User.IsInRole("Administrador");
}

<div class="page-header">
    <div>
        <h2>Fichas & producción</h2>
        <div class="sub">@(Model.IsAdministrator
            ? "Vista global: todas las fichas y sesiones de todos los instructores"
            : "Solo ve sus fichas y la producción que registró con ellas")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div data-toast data-toast-type="@(Model.IsSuccess ? "success" : "danger")" style="position:absolute;left:-9999px;">@Model.Message</div>
}

@if (User.IsInRole("Administrador") || User.IsInRole("Instructor"))
{
    <div class="card">
        <div class="card-title"><i class="fas fa-plus-circle"></i> Registrar ficha</div>
        <form asp-action="CreateFicha" method="post" class="create-ficha-form">
            @Html.AntiForgeryToken()
            <div class="create-ficha-grid">
                <div class="field">
                    <label class="field-label">Código de ficha</label>
                    <input asp-for="CreateFicha.FichaCode" placeholder="Ej. FICHA-T4" required maxlength="30" />
                </div>
                <div class="field">
                    <label class="field-label">Proceso</label>
                    <input asp-for="CreateFicha.ProcessName" list="procesos-ficha" placeholder="Trazo, Corte…" required />
                    <datalist id="procesos-ficha">
                        <option value="Trazo"></option>
                        <option value="Corte"></option>
                        <option value="Confección"></option>
                        <option value="Calidad"></option>
                        <option value="Terminado"></option>
                    </datalist>
                </div>
                <div class="field create-ficha-instructors">
                    <label class="field-label">Instructores registrados</label>
                    <select asp-for="CreateFicha.InstructorUserIds" multiple required size="4" class="create-ficha-multiselect">
                        @foreach (var instructor in instructorOptions)
                        {
                            if (Model.CreateFicha.InstructorUserIds.Contains(instructor.Id))
                            {
                                <option value="@instructor.Id" selected>@instructor.Nombre</option>
                            }
                            else
                            {
                                <option value="@instructor.Id">@instructor.Nombre</option>
                            }
                        }
                    </select>
                    <div class="hint create-ficha-hint">Ctrl/Cmd + clic para elegir varios. Solo usuarios con rol Instructor.</div>
                </div>
                <div class="field">
                    <label class="field-label">Turno</label>
                    <input asp-for="CreateFicha.Turno" list="turnos-ficha" placeholder="Mañana" required maxlength="20" />
                    <datalist id="turnos-ficha">
                        <option value="Mañana"></option>
                        <option value="Tarde"></option>
                        <option value="Noche"></option>
                    </datalist>
                </div>
                <div class="field">
                    <label class="field-label">Orden asignada</label>
                    <select id="createFichaOrderSelect" aria-label="Orden asignada">
                        <option value="" data-mode="none">— Opcional —</option>
                        @foreach (var o in Model.Orders)
                        {
                            <option value="@o.Id" data-mode="existing">@o.OrderNumber</option>
                        }
                        <option value="__manual__" data-mode="manual">Otro / Escribir manualmente</option>
                    </select>
                    <input type="hidden" asp-for="CreateFicha.ProductionOrderId" id="createFichaOrderId" />
                    <div id="createFichaOrderManualWrap" class="field" style="margin-top:8px;display:none;">
                        <label class="field-label" for="createFichaOrderText">Orden manual</label>
                        <input asp-for="CreateFicha.AssignedOrderText"
                               id="createFichaOrderText"
                               maxlength="100"
                               placeholder="Ej. OP-EXT-01"
                               style="width:100%" />
                    </div>
                </div>
            </div>
            <div class="create-ficha-actions">
                <button type="submit" class="primary"><i class="fas fa-save"></i> Registrar ficha</button>
            </div>
        </form>
    </div>
}

<div class="card">
    <div class="card-title teal"><i class="fas fa-chalkboard-user"></i> Fichas de aprendices / procesos</div>
    @if (!Model.Fichas.Any())
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-chalkboard-user", Title = "Sin fichas asignadas", Text = "No tiene fichas vinculadas a su cuenta de instructor.", ActionText = "Pida al administrador que le asigne una ficha en Usuarios." }' />
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Ficha</th><th>Proceso</th><th>Instructores</th><th>Turno</th><th>Orden asignada</th><th>Registro rápido</th><th>Materiales</th></tr></thead>
                <tbody>
                @foreach (var ficha in Model.Fichas)
                {
                    var assignedIds = ficha.Instructors?.Select(i => i.UserId).ToHashSet() ?? [];
                    var availableToAssign = instructorOptions.Where(i => !assignedIds.Contains(i.Id)).ToList();
                    var canRequestMaterials = isAdmin
                        || (User.IsInRole("Instructor")
                            && currentUserId is int uidReq
                            && (assignedIds.Contains(uidReq) || ficha.InstructorUserId == uidReq));
                    <tr>
                        <td><strong>@ficha.FichaCode</strong></td>
                        <td>@ficha.ProcessName</td>
                        <td>
                            <div class="instructor-chips">
                                @if (ficha.Instructors is { Count: > 0 })
                                {
                                    @foreach (var inst in ficha.Instructors)
                                    {
                                        var canEditProceso = isAdmin
                                            || (User.IsInRole("Instructor") && currentUserId == inst.UserId);
                                        var label = string.IsNullOrWhiteSpace(inst.Proceso)
                                            ? inst.Nombre
                                            : $"{inst.Nombre} ({inst.Proceso})";
                                        <span class="instructor-chip" data-instructor-chip>
                                            <span class="chip-view" data-chip-view>
                                                <span class="chip-label">@label</span>
                                                @if (canEditProceso)
                                                {
                                                    <button type="button"
                                                            class="chip-edit"
                                                            data-chip-edit
                                                            title="Editar proceso"
                                                            aria-label="Editar proceso de @inst.Nombre">
                                                        <i class="fas fa-pen" aria-hidden="true"></i>
                                                    </button>
                                                }
                                            </span>
                                            @if (canEditProceso)
                                            {
                                                <form asp-action="UpdateInstructorProceso"
                                                      method="post"
                                                      class="chip-edit-form"
                                                      data-chip-edit-form
                                                      hidden>
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="fichaId" value="@ficha.Id" />
                                                    <input type="hidden" name="instructorUserId" value="@inst.UserId" />
                                                    <input type="text"
                                                           name="proceso"
                                                           class="chip-proceso-input"
                                                           value="@inst.Proceso"
                                                           data-original-proceso="@inst.Proceso"
                                                           maxlength="60"
                                                           placeholder="Proceso"
                                                           aria-label="Proceso de @inst.Nombre" />
                                                    <button type="submit" class="small primary chip-save">Guardar</button>
                                                    <button type="button" class="small ghost chip-cancel" data-chip-cancel>Cancelar</button>
                                                </form>
                                            }
                                            <form asp-action="RemoveInstructor" method="post" class="chip-remove-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="fichaId" value="@ficha.Id" />
                                                <input type="hidden" name="instructorUserId" value="@inst.UserId" />
                                                <button type="submit" class="chip-remove" title="Quitar instructor" aria-label="Quitar @inst.Nombre">&times;</button>
                                            </form>
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span>@(string.IsNullOrWhiteSpace(ficha.InstructorName) ? "—" : ficha.InstructorName)</span>
                                }
                            </div>
                            @if (availableToAssign.Count > 0)
                            {
                                <form asp-action="AssignInstructor" method="post" class="assign-instructor-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="fichaId" value="@ficha.Id" />
                                    <select name="instructorUserId" required aria-label="Asignar instructor a @ficha.FichaCode">
                                        <option value="">— Asignar instructor —</option>
                                        @foreach (var opt in availableToAssign)
                                        {
                                            <option value="@opt.Id">@opt.Nombre</option>
                                        }
                                    </select>
                                    <input type="text" name="proceso" placeholder="Proceso (opcional)" maxlength="60" aria-label="Proceso del instructor" />
                                    <button type="submit" class="small ghost">Asignar</button>
                                </form>
                            }
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(ficha.Turno) ? "—" : ficha.Turno)</td>
                        <td>@(ficha.AssignedOrderNumber ?? "—")</td>
                        <td>
                            <form asp-action="QuickRegister" method="post" class="row-actions">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="fichaId" value="@ficha.Id" />
                                <input type="number" name="units" min="1" placeholder="uds" style="width:80px" required aria-label="Unidades" />
                                <input type="text" name="observations" placeholder="Observación" style="width:160px" aria-label="Observación" />
                                <button type="submit" class="small ghost">Registrar hoy</button>
                            </form>
                        </td>
                        <td>
                            @if (canRequestMaterials)
                            {
                                <button type="button"
                                        class="small primary"
                                        data-solicitud-toggle="#solicitud-form-@ficha.Id"
                                        aria-expanded="false"
                                        aria-controls="solicitud-form-@ficha.Id">
                                    Solicitar materiales
                                </button>
                            }
                            else
                            {
                                <span class="hint">—</span>
                            }
                        </td>
                    </tr>
                    @if (canRequestMaterials)
                    {
                        <tr id="solicitud-form-@ficha.Id" class="solicitud-form-row" hidden>
                            <td colspan="7">
                                <form asp-controller="SolicitudesMaterial"
                                      asp-action="Create"
                                      method="post"
                                      class="solicitud-material-form"
                                      data-solicitud-form>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="CreateSolicitud.FichaId" value="@ficha.Id" />
                                    <div class="solicitud-form-title">
                                        Solicitar materiales para <strong>@ficha.FichaCode</strong>
                                    </div>
                                    <div class="solicitud-rows" data-solicitud-rows>
                                        <div class="solicitud-row" data-solicitud-row>
                                            <div class="field">
                                                <label class="field-label">Material</label>
                                                <select name="CreateSolicitud.Detalles[0].MaterialId" required aria-label="Material">
                                                    <option value="">— Seleccione —</option>
                                                    @foreach (var mat in Model.Materials)
                                                    {
                                                        <option value="@mat.Id">@mat.Name (@mat.UnitDisplay)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="field">
                                                <label class="field-label">Cantidad</label>
                                                <input type="number"
                                                       name="CreateSolicitud.Detalles[0].CantidadSolicitada"
                                                       min="0.01"
                                                       step="0.01"
                                                       required
                                                       placeholder="0"
                                                       aria-label="Cantidad solicitada" />
                                            </div>
                                            <button type="button" class="small ghost danger" data-solicitud-remove hidden aria-label="Quitar material">Quitar</button>
                                        </div>
                                    </div>
                                    <template data-solicitud-row-template>
                                        <div class="solicitud-row" data-solicitud-row>
                                            <div class="field">
                                                <label class="field-label">Material</label>
                                                <select data-name-template="CreateSolicitud.Detalles[{i}].MaterialId" required aria-label="Material">
                                                    <option value="">— Seleccione —</option>
                                                    @foreach (var mat in Model.Materials)
                                                    {
                                                        <option value="@mat.Id">@mat.Name (@mat.UnitDisplay)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="field">
                                                <label class="field-label">Cantidad</label>
                                                <input type="number"
                                                       data-name-template="CreateSolicitud.Detalles[{i}].CantidadSolicitada"
                                                       min="0.01"
                                                       step="0.01"
                                                       required
                                                       placeholder="0"
                                                       aria-label="Cantidad solicitada" />
                                            </div>
                                            <button type="button" class="small ghost danger" data-solicitud-remove aria-label="Quitar material">Quitar</button>
                                        </div>
                                    </template>
                                    <div class="field" style="margin-top:10px;max-width:420px;">
                                        <label class="field-label">Observaciones (opcional)</label>
                                        <input type="text" name="CreateSolicitud.Observaciones" maxlength="500" placeholder="Notas para bodega" />
                                    </div>
                                    <div class="solicitud-form-actions">
                                        <button type="button" class="small ghost" data-solicitud-add @(Model.Materials.Count == 0 ? "disabled" : null)>
                                            <i class="fas fa-plus" aria-hidden="true"></i> Agregar material
                                        </button>
                                        <button type="submit" class="primary" @(Model.Materials.Count == 0 ? "disabled" : null)>
                                            Enviar solicitud
                                        </button>
                                        <button type="button" class="small ghost" data-solicitud-cancel>Cancelar</button>
                                    </div>
                                    @if (Model.Materials.Count == 0)
                                    {
                                        <div class="hint" style="margin-top:8px;">No hay materiales en inventario para solicitar.</div>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <form asp-action="Register" method="post" class="form-row" style="margin-top:18px;">
            @Html.AntiForgeryToken()
            <div class="field">
                <label class="field-label">Orden</label>
                <select asp-for="Register.ProductionOrderId" asp-items="@(new SelectList(Model.Orders, "Id", "OrderNumber"))"></select>
            </div>
            <div class="field">
                <label class="field-label">Ficha</label>
                <select asp-for="Register.FichaId">
                    @foreach (var f in Model.Fichas)
                    {
                        <option value="@f.Id">@f.FichaCode - @f.ProcessName</option>
                    }
                </select>
            </div>
            <div class="field" style="width:160px;">
                <label class="field-label">Unidades producidas</label>
                <input asp-for="Register.Units" type="number" min="1" required />
            </div>
            <div class="field" style="flex:1;min-width:220px;">
                <label class="field-label">Observaciones</label>
                <input asp-for="Register.Observations" placeholder="Notas de la sesión diaria" />
            </div>
            <button type="submit" class="primary"><i class="fas fa-save"></i> Registrar sesión diaria</button>
        </form>
        <div class="alert alert-info" style="margin-top:6px;">
            <i class="fas fa-circle-info"></i> Cada registro consume materiales según el BOM, actualiza el avance y guarda observaciones.
        </div>
    }
</div>

<div class="card">
    <div class="card-title"><i class="fas fa-filter"></i> Buscar fichas y sesiones</div>
    <form asp-action="Index" method="get" class="form-row">
        <div class="field" style="flex:1;min-width:160px;">
            <label class="field-label">Ficha</label>
            <input type="text" name="fichaCode" value="@Model.FichaCodeFilter" placeholder="Código de ficha" style="width:100%" />
        </div>
        <div class="field" style="flex:1;min-width:160px;">
            <label class="field-label">Instructor</label>
            <input type="text" name="instructor" value="@Model.InstructorFilter" placeholder="Nombre" style="width:100%" />
        </div>
        <div class="field" style="width:160px;">
            <label class="field-label">Turno</label>
            <select name="turno">
                <option value="">Todos</option>
                @if (string.Equals(Model.TurnoFilter, "Mañana", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="Mañana" selected>Mañana</option>
                }
                else
                {
                    <option value="Mañana">Mañana</option>
                }
                @if (string.Equals(Model.TurnoFilter, "Tarde", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="Tarde" selected>Tarde</option>
                }
                else
                {
                    <option value="Tarde">Tarde</option>
                }
                @if (string.Equals(Model.TurnoFilter, "Noche", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="Noche" selected>Noche</option>
                }
                else
                {
                    <option value="Noche">Noche</option>
                }
            </select>
        </div>
        <button type="submit" class="primary"><i class="fas fa-search"></i> Buscar</button>
        <a class="ghost" asp-action="Index" style="align-self:flex-end;padding:10px 14px;">Limpiar filtros</a>
    </form>
</div>

<div class="card">
    <div class="card-title amber"><i class="fas fa-clock-rotate-left"></i> @(Model.IsAdministrator ? "Sesiones recientes (todos los instructores)" : "Mis sesiones de producción")</div>
    @if (!Model.Sessions.Any())
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-clock-rotate-left", Title = "Sin sesiones registradas", Text = "Las sesiones diarias con observaciones aparecerán aquí.", ActionText = Model.Fichas.Any() ? "Registre una sesión con el formulario superior." : null }' />
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Ficha</th>
                        <th>Instructor</th>
                        <th>Turno</th>
                        <th>Orden</th>
                        <th>Unidades</th>
                        <th>Observaciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in Model.Sessions)
                {
                    <tr>
                        <td>@s.SessionDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@s.FichaCode</td>
                        <td>@s.InstructorName</td>
                        <td>@(string.IsNullOrWhiteSpace(s.Turno) ? "—" : s.Turno)</td>
                        <td>@s.OrderNumber</td>
                        <td>@s.Units</td>
                        <td>@(string.IsNullOrWhiteSpace(s.Observations) ? "—" : s.Observations)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
