@model PoliticaPrivacidadViewModel
@{
    Layout = Model.Autenticado ? "_Layout" : "_LoginLayout";
    var doc = Model.Documento;
}
<div class="card" style="max-width:820px;">
    <div class="card-title"><i class="fas fa-shield-halved"></i> Política de tratamiento de datos personales</div>
    <p>Versión @doc.Version · Actualizada: @doc.Fecha</p>
    @if (!string.Equals(doc.Version, Model.Opciones.VersionVigente(), StringComparison.Ordinal))
    {
        <p>Está viendo una versión anterior. <a asp-action="Index">Ver la versión vigente (@Model.Opciones.VersionVigente())</a>.</p>
    }
    @foreach (var bloque in doc.Bloques)
    {
        if (!string.IsNullOrWhiteSpace(bloque.Titulo))
        {
            <h3>@bloque.Titulo</h3>
        }
        foreach (var parrafo in bloque.Parrafos)
        {
            <p>@parrafo</p>
        }
        if (bloque.Items.Count > 0)
        {
            <ul>
                @foreach (var item in bloque.Items)
                {
                    <li>@item</li>
                }
            </ul>
        }
        foreach (var enlace in bloque.Enlaces)
        {
            <p><a href="@enlace.Url" target="_blank" rel="noopener noreferrer">@enlace.Texto</a></p>
        }
    }
</div>
