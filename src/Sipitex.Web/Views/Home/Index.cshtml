@model DashboardKpiDto
@{
    // Página de inicio con accesos rápidos a cada módulo
    ViewData["Title"] = "Inicio";
    ViewData["Breadcrumb"] = "SIPITEX / Inicio";
    var stockTotal = Model.OkStockCount + Model.LowStockCount + Model.CriticalStockCount + Model.SinMinimoStockCount;
}

<div class="page-header">
    <div>
        <h2>Panel SIPITEX</h2>
        <div class="sub">Seleccione un módulo operativo para continuar</div>
    </div>
</div>

<div class="kpi-grid">
    <div class="kpi-card teal">
        <div class="kpi-label">Stock OK</div>
        <div class="kpi-value">@Model.OkStockCount</div>
        <div class="kpi-trend">En o sobre el mínimo</div>
    </div>
    <div class="kpi-card amber">
        <div class="kpi-label">Stock bajo</div>
        <div class="kpi-value">@Model.LowStockCount</div>
        <div class="kpi-trend">Con existencias, bajo el mínimo</div>
    </div>
    <div class="kpi-card red">
        <div class="kpi-label">Stock crítico</div>
        <div class="kpi-value">@Model.CriticalStockCount</div>
        <div class="kpi-trend">Sin existencias, con mínimo definido</div>
    </div>
    <div class="kpi-card neutral">
        <div class="kpi-label">Sin mínimo</div>
        <div class="kpi-value">@Model.SinMinimoStockCount</div>
        <div class="kpi-trend">@stockTotal insumos · los cuatro niveles suman el total</div>
    </div>
</div>

<div class="module-grid">
    @if (User.IsInRole("Administrador") || User.IsInRole("Encargado de bodega"))
    {
        <a class="module-link" asp-controller="PlantasInventario" asp-action="Index">
            <i class="fas fa-warehouse"></i>
            <h3>Plantas de inventario</h3>
            <p>Inventario de materiales e insumos de cada planta.</p>
        </a>
    }
    <a class="module-link" asp-controller="Ordenes" asp-action="Index">
        <i class="fas fa-clipboard-list"></i>
        <h3>Órdenes</h3>
        <p>Órdenes de producción y avance.</p>
    </a>
    <a class="module-link" asp-controller="Mrp" asp-action="Index">
        <i class="fas fa-diagram-project"></i>
        <h3>MRP</h3>
        <p>BOM y simulación de requerimientos.</p>
    </a>
    <a class="module-link" asp-controller="Fichas" asp-action="Index">
        <i class="fas fa-people-group"></i>
        <h3>Fichas</h3>
        <p>Registro de producción por ficha.</p>
    </a>
    <a class="module-link" asp-controller="Calidad" asp-action="Index">
        <i class="fas fa-clipboard-check"></i>
        <h3>Calidad</h3>
        <p>Inspecciones y resultados.</p>
    </a>
    <a class="module-link" asp-controller="Estadisticas" asp-action="Index">
        <i class="fas fa-chart-line"></i>
        <h3>Estadísticas</h3>
        <p>KPIs y métricas del centro.</p>
    </a>
    <a class="module-link" asp-controller="Reportes" asp-action="Index">
        <i class="fas fa-file-export"></i>
        <h3>Reportes</h3>
        <p>Exportar PDF y Excel.</p>
    </a>
    <a class="module-link" asp-controller="Alertas" asp-action="Index">
        <i class="fas fa-bell"></i>
        <h3>Alertas</h3>
        <p>Preferencias de correo por actor.</p>
    </a>
</div>
