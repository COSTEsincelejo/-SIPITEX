@model OrdenesIndexViewModel
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Órdenes de producción";
    ViewData["Breadcrumb"] = "SIPITEX / Operación / Órdenes de producción";
    Layout = "_Layout";
    var puedeCrear = (await AuthorizationService.AuthorizeAsync(User, resource: null, Sipitex.Application.Authorization.AuthorizationPolicyNames.PuedeCrearOrdenes)).Succeeded;
    var isAdmin = User.IsInRole("Administrador");
    var isInstructor = User.IsInRole("Instructor");
    var pendientes = Model.Orders.Where(o => o.Status == OrderStatus.Pendiente).ToList();
    var ordersSorted = Model.Orders
        .OrderBy(o => o.Status == OrderStatus.Pendiente ? 0 : o.Status == OrderStatus.EnProceso ? 1 : 2)
        .ThenByDescending(o => o.Id)
        .ToList();
}

<div class="page-header">
    <div>
        <h2>Órdenes de producción</h2>
        <div class="sub">
            @if (isInstructor)
            {
                <text>Sus órdenes asignadas (operar) y las que puede preparar por materiales. El alcance se indica en cada fila.</text>
            }
            else if (isAdmin)
            {
                <text>Cree órdenes (quedan Pendiente) y apruébelas para iniciar producción/MES.</text>
            }
            else
            {
                <text>Consulta de órdenes y estado de materiales / avance.</text>
            }
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div data-toast data-toast-type="@(Model.IsSuccess ? "success" : "danger")" style="position:absolute;left:-9999px;">@Model.Message</div>
}

@if (isAdmin && pendientes.Count > 0)
{
    <div class="approve-banner">
        <div class="approve-copy">
            <i class="fas fa-hourglass-half" aria-hidden="true"></i>
            <div>
                <strong>@pendientes.Count orden(es) pendiente(s) de aprobación</strong>
                <p>Hasta aprobar no hay producción, MES ni entrega física de materiales. Puede preparar la lista de materiales mientras tanto.</p>
            </div>
        </div>
        <a class="primary" href="#orden-@pendientes[0].Id"><i class="fas fa-arrow-down"></i> Ir a la primera</a>
    </div>
}

@* Admin o Instructor con Ordenes.Crear *@
@if (puedeCrear)
{
<div class="card">
    <div class="card-title"><i class="fas fa-clipboard-list"></i> Crear orden de producción</div>
    <div class="grid-2col">
        <div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="form-row">
                    <div class="field" style="flex:1;">
                        <label class="field-label">Producto</label>
                        <input asp-for="CreateOrder.ProductName" list="productos" placeholder="Producto con ficha técnica" style="width:100%" required />
                        <datalist id="productos">
                            @foreach (var name in Model.ProductNames)
                            {
                                <option value="@name"></option>
                            }
                        </datalist>
                    </div>
                    <div class="field" style="width:140px;">
                        <label class="field-label">Cantidad total</label>
                        <input asp-for="CreateOrder.TotalQuantity" type="number" min="1" required />
                    </div>
                    <div class="field" style="width:180px;">
                        <label class="field-label">Cliente (opc.)</label>
                        <input asp-for="CreateOrder.ClientName" maxlength="120" placeholder="Cliente" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="field">
                        <label class="field-label">Fecha límite</label>
                        <input asp-for="CreateOrder.Deadline" type="date" required />
                    </div>
                    <button type="submit" class="primary"><i class="fas fa-bolt"></i> Generar orden + MRP</button>
                </div>
            </form>
        </div>
        <div class="alert alert-info" style="margin:0;align-self:flex-start;">
            <i class="fas fa-microchip"></i>
            La orden nace en <span class="badge has-icon badge-warning"><i class="fas fa-hourglass-half"></i><span class="badge-text">Pendiente</span></span>
            y pasa a <span class="badge has-icon badge-info"><i class="fas fa-play"></i><span class="badge-text">En proceso</span></span>
            cuando el Administrador la aprueba.
        </div>
    </div>
</div>
}

<div class="card">
    <div class="card-title"><i class="fas fa-list"></i> Listado</div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Orden</th>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Producido</th>
                    <th>Avance</th>
                    <th>Estado</th>
                    <th>Materiales</th>
                    @if (isInstructor)
                    {
                        <th>Su alcance</th>
                    }
                    <th>MRP sugerido</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var order in ordersSorted)
            {
                var rowClass = order.Status == OrderStatus.Pendiente ? "order-row-pendiente" : null;
                <tr id="orden-@order.Id" class="@rowClass">
                    <td>
                        <strong>@order.OrderNumber</strong>
                        <div><a class="hint" asp-action="Detail" asp-route-id="@order.Id">Ver detalle / flujo</a></div>
                    </td>
                    <td>@order.ProductName</td>
                    <td>@order.TotalQuantity</td>
                    <td>@order.ProducedQuantity</td>
                    <td style="min-width:120px;">
                        @{
                            var bar = order.CombinedProgressPercent > 0 ? order.CombinedProgressPercent : order.ProgressPercent;
                        }
                        <div class="progress-track"><div class="progress-fill" style="width:@bar%"></div></div>
                        <div style="font-size:11px;color:var(--text-mut);margin-top:4px;">
                            @bar%
                            @if (!string.IsNullOrWhiteSpace(order.CurrentStageName))
                            {
                                <span>· @order.CurrentStageName</span>
                            }
                        </div>
                    </td>
                    <td>
                        <partial name="_StatusBadge" model="new StatusBadgeModel {
                            CssClass = DisplayHelper.BadgeClass(order.Status),
                            Icon = DisplayHelper.StatusIcon(order.Status),
                            Text = DisplayHelper.StatusText(order.Status)
                        }" />
                    </td>
                    <td>
                        <partial name="_StatusBadge" model="new StatusBadgeModel {
                            CssClass = DisplayHelper.BadgeClass(order.MaterialsStatus),
                            Icon = DisplayHelper.StatusIcon(order.MaterialsStatus),
                            Text = DisplayHelper.StatusText(order.MaterialsStatus)
                        }" />
                    </td>
                    @if (isInstructor)
                    {
                        <td>
                            @if (order.CanOperateProduction && order.CanManageMaterials)
                            {
                                <span class="access-chip access-both" title="Puede operar MES/producción y preparar materiales"><i class="fas fa-gears"></i> Operar</span>
                            }
                            else if (order.CanOperateProduction)
                            {
                                <span class="access-chip access-operate" title="Asignado a la orden: puede operar MES/producción"><i class="fas fa-gears"></i> Operar</span>
                            }
                            else if (order.CanManageMaterials)
                            {
                                <span class="access-chip access-materials" title="Habilitado por ficha/BOM: solo preparar materiales"><i class="fas fa-boxes-stacked"></i> Solo materiales</span>
                            }
                            else
                            {
                                <span class="hint">—</span>
                            }
                        </td>
                    }
                    <td><small style="color:var(--text-mut);">@order.MrpHint</small></td>
                    <td>
                        @if (order.Status == OrderStatus.Pendiente)
                        {
                            @if (isAdmin)
                            {
                                <form asp-action="Approve" method="post" class="row-actions"
                                      onsubmit="return confirm('¿Aprobar @order.OrderNumber e iniciar producción/MES?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <button type="submit" class="primary small"><i class="fas fa-check"></i> Aprobar orden</button>
                                </form>
                                <div style="margin-top:6px;">
                                    <a class="hint" asp-action="Detail" asp-route-id="@order.Id">Revisar antes</a>
                                </div>
                            }
                            else
                            {
                                <span class="hint">Espera aprobación Admin</span>
                            }
                        }
                        else if (order.CanOperateProduction
                                 && order.Status is not (OrderStatus.Finalizada or OrderStatus.Cancelada)
                                 && order.CanRegisterProduction)
                        {
                            <form asp-action="AddProduction" method="post" class="row-actions">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@order.Id" />
                                <input type="number" name="units" min="1" step="1" value="1" placeholder="uds" style="width:72px" required aria-label="Unidades a registrar" />
                                <button type="submit" class="small ghost">+ uds</button>
                            </form>
                        }
                        else if (order.Status == OrderStatus.Cancelada)
                        {
                            <span class="hint">Cancelada</span>
                        }
                        else if (order.Status != OrderStatus.Finalizada && !order.CanRegisterProduction)
                        {
                            <span class="hint">Pendiente bodega</span>
                        }
                        else if (isInstructor && order.CanManageMaterials && !order.CanOperateProduction)
                        {
                            <a class="small ghost" asp-action="Detail" asp-route-id="@order.Id"><i class="fas fa-boxes-stacked"></i> Preparar materiales</a>
                        }
                        @if (isAdmin && order.Status is not (OrderStatus.Cancelada or OrderStatus.Finalizada))
                        {
                            <div style="margin-top:4px;">
                                <a class="hint" asp-action="Edit" asp-route-id="@order.Id">Editar</a>
                            </div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
