@model OrdenesIndexViewModel
@{
    ViewData["Title"] = "Órdenes de producción";
    ViewData["Breadcrumb"] = "SIPITEX / Operación / Órdenes de producción";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h2>Órdenes de producción</h2>
        <div class="sub">Cree órdenes para cualquier producto: escriba el nombre libremente (no solo Camisa o Pantalón)</div>
    </div>
</div>

<div class="card">
    <div class="card-title"><i class="fas fa-clipboard-list"></i> Crear orden de producción</div>
    <div class="grid-2col">
        <div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="form-row">
                    <div class="field" style="flex:1;">
                        <label class="field-label">Producto</label>
                        <input asp-for="CreateOrder.ProductName"
                               list="productos-conocidos"
                               placeholder="Ej. Vestido, Chaqueta, Falda, Uniforme…"
                               style="width:100%"
                               maxlength="80"
                               required />
                        <datalist id="productos-conocidos">
                            @foreach (var name in Model.KnownProducts)
                            {
                                <option value="@name"></option>
                            }
                        </datalist>
                        <small class="field-hint">Puede escribir cualquier prenda. Las sugerencias son opcionales.</small>
                    </div>
                    <div class="field" style="width:140px;">
                        <label class="field-label">Cantidad total</label>
                        <input asp-for="CreateOrder.TotalQuantity" type="number" min="1" required />
                    </div>
                </div>
                <div class="form-row">
                    <div class="field">
                        <label class="field-label">Fecha límite</label>
                        <input asp-for="CreateOrder.Deadline" type="date" required />
                    </div>
                    <button type="submit" class="primary"><i class="fas fa-bolt"></i> Generar orden</button>
                </div>
            </form>
        </div>
        <div class="alert alert-info" style="margin:0;align-self:flex-start;">
            <i class="fas fa-microchip"></i>
            Si el producto ya tiene ficha BOM en MRP, se calcula el material automáticamente.
            Si es nuevo, cree la orden igual y luego agregue materiales en <strong>MRP / Materiales</strong>.
        </div>
    </div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Orden</th><th>Producto</th><th>Cantidad</th><th>Producido</th><th>Avance</th><th>Estado</th><th>MRP sugerido</th><th></th></tr></thead>
            <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr>
                    <td><strong>@order.OrderNumber</strong></td>
                    <td>@order.ProductName</td>
                    <td>@order.TotalQuantity</td>
                    <td>@order.ProducedQuantity</td>
                    <td style="min-width:120px;">
                        <div class="progress-track"><div class="progress-fill" style="width:@order.ProgressPercent%"></div></div>
                        <div style="font-size:11px;color:var(--text-mut);margin-top:4px;">@order.ProgressPercent%</div>
                    </td>
                    <td><span class="badge @DisplayHelper.BadgeClass(order.Status)">@DisplayHelper.StatusText(order.Status)</span></td>
                    <td><small style="color:var(--text-mut);">@order.MrpHint</small></td>
                    <td>
                        @if (order.Status != OrderStatus.Finalizada)
                        {
                            <form asp-action="AddProduction" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@order.Id" />
                                <button type="submit" class="small ghost">+ 10u</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
