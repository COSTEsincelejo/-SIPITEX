@model OrdenesIndexViewModel
@{
    ViewData["Title"] = "Órdenes de producción";
    ViewData["Breadcrumb"] = "SIPITEX / Operación / Órdenes de producción";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h2>Órdenes de producción</h2>
        <div class="sub">Crea órdenes y genera el cálculo MRP automático</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div data-toast data-toast-type="@(Model.IsSuccess ? "success" : "danger")" style="position:absolute;left:-9999px;">@Model.Message</div>
}

@* Solo el admin puede crear órdenes nuevas *@
@if (User.IsInRole("Administrador"))
{
<div class="card">
    <div class="card-title"><i class="fas fa-clipboard-list"></i> Crear orden de producción</div>
    <div class="grid-2col">
        <div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="form-row">
                    <div class="field" style="flex:1;">
                        <label class="field-label">Producto</label>
                        <input asp-for="CreateOrder.ProductName" list="productos" placeholder="Producto con ficha técnica" style="width:100%" required />
                        <datalist id="productos">
                            @foreach (var name in Model.ProductNames)
                            {
                                <option value="@name"></option>
                            }
                        </datalist>
                    </div>
                    <div class="field" style="width:140px;">
                        <label class="field-label">Cantidad total</label>
                        <input asp-for="CreateOrder.TotalQuantity" type="number" min="1" required />
                    </div>
                </div>
                <div class="form-row">
                    <div class="field">
                        <label class="field-label">Fecha límite</label>
                        <input asp-for="CreateOrder.Deadline" type="date" required />
                    </div>
                    <button type="submit" class="primary"><i class="fas fa-bolt"></i> Generar orden + MRP</button>
                </div>
            </form>
        </div>
        <div class="alert alert-info" style="margin:0;align-self:flex-start;">
            <i class="fas fa-microchip"></i> El sistema calcula automáticamente los materiales requeridos (BOM) según la ficha técnica del producto.
        </div>
    </div>
</div>
}

<div class="card">
    <div class="table-wrap">
        <table>
            <thead><tr><th>Orden</th><th>Producto</th><th>Cantidad</th><th>Producido</th><th>Avance</th><th>Estado</th><th>Materiales</th><th>MRP sugerido</th><th></th></tr></thead>
            <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr>
                    <td>
                        <strong>@order.OrderNumber</strong>
                        <div><a class="hint" asp-action="Detail" asp-route-id="@order.Id">Materiales</a></div>
                    </td>
                    <td>@order.ProductName</td>
                    <td>@order.TotalQuantity</td>
                    <td>@order.ProducedQuantity</td>
                    <td style="min-width:120px;">
                        <div class="progress-track"><div class="progress-fill" style="width:@order.ProgressPercent%"></div></div>
                        <div style="font-size:11px;color:var(--text-mut);margin-top:4px;">@order.ProgressPercent%</div>
                    </td>
                    <td><span class="badge @DisplayHelper.BadgeClass(order.Status)">@DisplayHelper.StatusText(order.Status)</span></td>
                    <td><span class="badge @DisplayHelper.BadgeClass(order.MaterialsStatus)">@DisplayHelper.StatusText(order.MaterialsStatus)</span></td>
                    <td><small style="color:var(--text-mut);">@order.MrpHint</small></td>
                    <td>
                        @* Campo libre: sumar N unidades (mín. 1) si la orden no está finalizada y materiales listos *@
                        @if (order.Status != OrderStatus.Finalizada && order.CanRegisterProduction)
                        {
                            <form asp-action="AddProduction" method="post" class="row-actions">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@order.Id" />
                                <input type="number" name="units" min="1" step="1" value="1" placeholder="uds" style="width:72px" required aria-label="Unidades a registrar" />
                                <button type="submit" class="small ghost">+ uds</button>
                            </form>
                        }
                        else if (order.Status != OrderStatus.Finalizada && !order.CanRegisterProduction)
                        {
                            <span class="hint">Pendiente bodega</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
