@model VerificarActaViewModel
@{
    ViewData["Title"] = "Verificar acta";
    ViewData["Breadcrumb"] = "SIPITEX / Verificar acta";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h2>Verificación de acta</h2>
        <div class="sub">Comprueba el código impreso en el PDF. Esta página no muestra el contenido del documento.</div>
    </div>
</div>

<div class="card">
    @if (Model.Autentica)
    {
        <p><span class="badge badge-success">Documento auténtico</span></p>
        <p>Número: <strong>@Model.Numero</strong></p>
        <p>Tipo: <strong>@Model.Tipo</strong></p>
        <p>Fecha: <strong>@Model.Fecha</strong></p>
        <p>Estado: <strong>@Model.Estado</strong></p>
        <p>Ítems: <strong>@Model.CantidadItems</strong></p>
    }
    else
    {
        <p><span class="badge badge-danger">El código no coincide</span></p>
    }
</div>
