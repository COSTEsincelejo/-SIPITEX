@model CostosIndexViewModel
@{
    ViewData["Title"] = "Costeo de prendas";
    ViewData["Breadcrumb"] = "SIPITEX / Análisis / Costeo";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h2>Costeo de prendas</h2>
        <div class="sub">
            El costo final es solo materiales: (Σ cantidad consumida × costo unitario congelado al consumo) / volumen × volumen de la orden.
            Mano de obra y overhead no entran en el total.
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div data-toast data-toast-type="@(Model.IsSuccess ? "success" : "danger")" style="position:absolute;left:-9999px;">@Model.Message</div>
}

@if (Model.CanEditRate)
{
    <div class="card">
        <div class="card-title"><i class="fas fa-sliders"></i> Tarifa de hora (referencia, no entra al costeo)</div>
        <p class="hint">Valor de referencia CMTC en COP por hora de grupo de confección. No se suma al costo final de la prenda.</p>
        <form asp-action="Tarifa" method="post" class="form-row">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderId" value="@Model.OrderId" />
            <div class="field">
                <label class="field-label" for="laborHourRate">COP / hora</label>
                <input id="laborHourRate" name="laborHourRate" type="number" min="0.01" step="0.01" value="@Model.LaborHourRate.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
            </div>
            <div class="field" style="align-self:flex-end;">
                <button type="submit" class="primary small"><i class="fas fa-save"></i> Guardar tarifa</button>
            </div>
        </form>
    </div>
}

<div class="card">
    <div class="card-title"><i class="fas fa-filter"></i> Consultar por orden</div>
    <form method="get" class="form-row">
        <div class="field">
            <label class="field-label">Orden</label>
            <select name="orderId" asp-items="@(new SelectList(Model.Orders, "Id", "OrderNumber", Model.OrderId))"></select>
        </div>
        <div class="field" style="align-self:flex-end;">
            <button type="submit" class="small">Calcular</button>
        </div>
    </form>
</div>

@if (Model.Costo is null)
{
    <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-coins", Title = "Sin órdenes", Text = "No hay órdenes de producción para costear." }' />
}
else
{
    <div class="card">
        <div class="card-title"><i class="fas fa-coins"></i> @Model.Costo.OrderNumber</div>
        <p class="text-muted hint">@Model.Costo.Formula</p>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Concepto</th>
                        <th>Detalle</th>
                        <th class="text-end">Valor</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Volumen de la orden</td>
                        <td>Cantidad de prendas pedidas</td>
                        <td class="text-end">@Model.Costo.Volumen</td>
                    </tr>
                    <tr>
                        <td>Costo materiales (por unidad)</td>
                        <td>Σ (cantidad consumida × costo unitario al momento) / volumen</td>
                        <td class="text-end">@Model.Costo.CostoMaterialesPorUnidad.ToString("0.####")</td>
                    </tr>
                    <tr>
                        <td>Costo final (orden)</td>
                        <td>Costo por unidad × volumen</td>
                        <td class="text-end"><strong>@Model.Costo.Total.ToString("0.####")</strong></td>
                    </tr>
                    <tr>
                        <td>Mano de obra</td>
                        <td>@Model.Costo.HorasManoObra.ToString("0.##") h × @Model.Costo.TarifaHora.ToString("0.####") / h — excluida del costo final</td>
                        <td class="text-end">0</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}
