@model CostosIndexViewModel
@{
    ViewData["Title"] = "Costeo de prendas";
    ViewData["Breadcrumb"] = "SIPITEX / Análisis / Costeo";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h2>Costeo de prendas</h2>
        <div class="sub">
            Materiales = cantidad consumida × costo histórico de la última entrada con precio.
            Mano de obra = horas del grupo de confección × tarifa de hora configurada.
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div data-toast data-toast-type="@(Model.IsSuccess ? "success" : "danger")" style="position:absolute;left:-9999px;">@Model.Message</div>
}

@if (Model.LaborHourRateUnconfigured)
{
    <div class="alert alert-warning">
        Tarifa de mano de obra sin configurar — el costo de mano de obra no se incluye hasta que el Administrador la defina.
    </div>
}
else
{
    <div class="alert alert-info">
        Tarifa vigente: <strong>@Model.LaborHourRate.ToString("0.####") / h</strong>
    </div>
}

@if (Model.CanEditRate)
{
    <div class="card">
        <div class="card-title"><i class="fas fa-sliders"></i> Tarifa de hora (Administrador)</div>
        <p class="hint">Valor de referencia CMTC en COP por hora de grupo de confección. Puede ajustarlo sin redesplegar.</p>
        <form asp-action="Tarifa" method="post" class="form-row">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderId" value="@Model.OrderId" />
            <div class="field">
                <label class="field-label" for="laborHourRate">COP / hora</label>
                <input id="laborHourRate" name="laborHourRate" type="number" min="0.01" step="0.01" value="@Model.LaborHourRate.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
            </div>
            <div class="field" style="align-self:flex-end;">
                <button type="submit" class="primary small"><i class="fas fa-save"></i> Guardar tarifa</button>
            </div>
        </form>
    </div>
}

<div class="card">
    <div class="card-title"><i class="fas fa-filter"></i> Consultar por orden</div>
    <form method="get" class="form-row">
        <div class="field">
            <label class="field-label">Orden</label>
            <select name="orderId" asp-items="@(new SelectList(Model.Orders, "Id", "OrderNumber", Model.OrderId))"></select>
        </div>
        <div class="field" style="align-self:flex-end;">
            <button type="submit" class="small">Calcular</button>
        </div>
    </form>
</div>

@if (Model.Costo is null)
{
    <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-coins", Title = "Sin órdenes", Text = "No hay órdenes de producción para costear." }' />
}
else
{
    <div class="card">
        <div class="card-title"><i class="fas fa-coins"></i> @Model.Costo.OrderNumber</div>
        <p class="text-muted hint">@Model.Costo.Formula</p>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Concepto</th>
                        <th>Detalle</th>
                        <th class="text-end">Valor</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Materiales</td>
                        <td>Consumo real × costo de adquisición histórico</td>
                        <td class="text-end">@Model.Costo.CostoMateriales.ToString("0.####")</td>
                    </tr>
                    <tr>
                        <td>Mano de obra</td>
                        <td>@Model.Costo.HorasManoObra.ToString("0.##") h × @Model.Costo.TarifaHora.ToString("0.####") / h</td>
                        <td class="text-end">@Model.Costo.CostoManoObra.ToString("0.####")</td>
                    </tr>
                    <tr>
                        <td colspan="2"><strong>Total estimado</strong></td>
                        <td class="text-end"><strong>@Model.Costo.Total.ToString("0.####")</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}
