@model MrpIndexViewModel
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "MRP / Materiales";
    ViewData["Breadcrumb"] = "SIPITEX / Operación / MRP";
    Layout = "_Layout";
    var puedeSimular = (await AuthorizationService.AuthorizeAsync(User, resource: null, Sipitex.Application.Authorization.AuthorizationPolicyNames.PuedeSimularMrp)).Succeeded;
    var puedeGestionar = (await AuthorizationService.AuthorizeAsync(User, resource: null, Sipitex.Application.Authorization.AuthorizationPolicyNames.PuedeGestionarFichasTecnicas)).Succeeded;
}

<div class="page-header">
    <div>
        <h2>MRP / Materiales</h2>
        <div class="sub">Fichas técnicas (BOM) y simulación de requerimiento neto</div>
    </div>
    @if (puedeGestionar)
    {
        <a class="primary" asp-action="Create"><i class="fas fa-plus"></i> Nueva ficha técnica</a>
    }
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div data-toast data-toast-type="@(Model.IsSuccess ? "success" : "danger")" style="position:absolute;left:-9999px;">@Model.Message</div>
}

<div class="card">
    <div class="card-title amber"><i class="fas fa-clipboard-list"></i> Fichas técnicas por producto</div>
    @if (!Model.Products.Any())
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-diagram-project", Title = "Sin fichas técnicas", Text = "Todavía no hay productos con BOM.", ActionText = puedeGestionar ? "Cree la primera ficha técnica." : null }' />
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Materiales</th>
                        <th>Estado</th>
                        <th>Notas</th>
                        @if (Model.IsAdministrator) { <th>Instructores</th> }
                        @if (puedeGestionar) { <th></th> }
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model.Products)
                {
                    var assignedIds = (p.Instructors ?? []).Select(i => i.UserId).ToHashSet();
                    var availableToAssign = Model.Instructors.Where(i => !assignedIds.Contains(i.Id)).ToList();
                    <tr>
                        <td><strong>@p.ProductName</strong></td>
                        <td>@p.MaterialCount</td>
                        <td>
                            @if (p.IsReference)
                            {
                                <span class="badge badge-warning">Referencia</span>
                            }
                            @if (!p.HabilitadoParaOrdenes)
                            {
                                <span class="badge badge-danger">No habilitado para órdenes</span>
                            }
                            else if (!p.IsReference)
                            {
                                <span class="badge badge-success">Habilitado</span>
                            }
                        </td>
                        <td><small style="color:var(--text-mut);">@(p.Notes ?? "—")</small></td>
                        @if (Model.IsAdministrator)
                        {
                            <td>
                                <div class="chip-row" style="flex-wrap:wrap;gap:6px;margin-bottom:6px;">
                                    @if (p.Instructors is { Count: > 0 })
                                    {
                                        @foreach (var inst in p.Instructors)
                                        {
                                            <span class="badge badge-info" style="display:inline-flex;align-items:center;gap:4px;">
                                                @inst.Nombre
                                                <form asp-action="RemoveInstructor" method="post" style="display:inline;margin:0;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="bomProductId" value="@p.Id" />
                                                    <input type="hidden" name="instructorUserId" value="@inst.UserId" />
                                                    <button type="submit" class="chip-remove" title="Quitar instructor" aria-label="Quitar @inst.Nombre">&times;</button>
                                                </form>
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="hint">Sin instructores</span>
                                    }
                                </div>
                                @if (availableToAssign.Count > 0)
                                {
                                    <form asp-action="AssignInstructor" method="post" class="row-actions" style="flex-wrap:wrap;gap:6px;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bomProductId" value="@p.Id" />
                                        <select name="instructorUserId" required aria-label="Asignar instructor a @p.ProductName">
                                            <option value="">— Asignar instructor —</option>
                                            @foreach (var opt in availableToAssign)
                                            {
                                                <option value="@opt.Id">@opt.Nombre</option>
                                            }
                                        </select>
                                        <button type="submit" class="small ghost">Asignar</button>
                                    </form>
                                }
                            </td>
                        }
                        @if (puedeGestionar)
                        {
                            <td class="row-actions">
                                <a class="small ghost" asp-action="Edit" asp-route-id="@p.Id"><i class="fas fa-pen"></i> Editar</a>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <form asp-action="Delete" method="post" style="display:inline;" onsubmit="return confirm('¿Eliminar la ficha técnica de «@p.ProductName»? Quedará sin BOM.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button type="submit" class="small ghost danger"><i class="fas fa-trash"></i> Eliminar</button>
                                    </form>
                                }
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card">
    <div class="card-title amber"><i class="fas fa-chart-pie"></i> Lista de materiales por producto (BOM)</div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Producto</th><th>Material</th><th>Cantidad por unidad</th><th>Unidad</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Bom)
            {
                <tr>
                    <td><strong>@item.ProductName</strong></td>
                    <td>@item.MaterialName</td>
                    <td>@item.QuantityPerUnit</td>
                    <td>@item.UnitDisplay</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (puedeSimular)
{
<div class="card">
    <div class="card-title amber"><i class="fas fa-calculator"></i> Simulación de requerimiento neto</div>
    <form asp-action="Simulate" method="post" class="form-row">
        @Html.AntiForgeryToken()
        <div class="field">
            <label class="field-label">Producto</label>
            <select asp-for="Simulation.ProductName">
                @foreach (var name in Model.ProductNames)
                {
                    <option value="@name">@name</option>
                }
            </select>
        </div>
        <div class="field" style="width:160px;">
            <label class="field-label">Cantidad a fabricar</label>
            <input asp-for="Simulation.Quantity" type="number" step="1" min="1" />
        </div>
        <button type="submit" class="primary"><i class="fas fa-play"></i> Calcular MRP y alerta stock</button>
    </form>
    @if (Model.Result is not null)
    {
        <div class="alert alert-info">
            <i class="fas fa-chart-pie"></i>
            <div>
                <strong>MRP para @Model.Result.ProductName (@Model.Result.Quantity uds):</strong><br />
                @foreach (var line in Model.Result.Lines)
                {
                    <text>
                        <strong>@line.MaterialName:</strong> necesita @line.Required.ToString("0.0") @line.UnitDisplay,
                        disponible @line.Available.ToString("0.0") →
                        @if (line.IsOk)
                        {
                            <span style="color:var(--teal);font-weight:600;">OK</span>
                        }
                        else
                        {
                            <span style="color:var(--red);font-weight:600;">Déficit @line.Deficit.ToString("0.0")</span>
                        }
                        <br />
                    </text>
                }
            </div>
        </div>
    }
</div>
}
