@model MrpIndexViewModel
@{
    ViewData["Title"] = "MRP / Materiales";
    ViewData["Breadcrumb"] = "SIPITEX / Operación / MRP";
    Layout = "_Layout";
    var canEditBom = PermissionHelper.CanManageInventory(User);
}

<div class="page-header">
    <div>
        <h2>MRP / Materiales</h2>
        <div class="sub">Ficha técnica (BOM) por producto y simulación de requerimiento — para cualquier prenda</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div data-toast data-toast-type="@(Model.IsSuccess ? "success" : "danger")" class="visually-hidden">@Model.Message</div>
}

@if (canEditBom)
{
    <div class="card">
        <div class="card-title"><i class="fas fa-plus"></i> Agregar material a un producto</div>
        <p class="sub" style="margin-bottom:12px;">Escriba el producto y el material que necesita (existente o nuevo). Si el material no existe, se registra automáticamente.</p>
        <form asp-action="AddBomItem" method="post" class="form-row">
            @Html.AntiForgeryToken()
            <div class="field" style="flex:1;min-width:180px;">
                <label class="field-label">Producto</label>
                <input asp-for="AddBom.ProductName" list="mrp-productos" placeholder="Ej. Vestido, Overol…" maxlength="80" required style="width:100%" />
                <datalist id="mrp-productos">
                    @foreach (var name in Model.KnownProducts)
                    {
                        <option value="@name"></option>
                    }
                </datalist>
            </div>
            <div class="field" style="flex:1;min-width:180px;">
                <label class="field-label">Material</label>
                <input asp-for="AddBom.MaterialName"
                       list="mrp-materiales"
                       placeholder="Escriba el material que necesita…"
                       maxlength="80"
                       required
                       style="width:100%" />
                <datalist id="mrp-materiales">
                    @foreach (var m in Model.Materials)
                    {
                        <option value="@m.Name"></option>
                    }
                </datalist>
            </div>
            <div class="field" style="width:140px;">
                <label class="field-label">Unidad (si es nuevo)</label>
                <select asp-for="AddBom.Unit" asp-items="Html.GetEnumSelectList<MaterialUnit>()"></select>
            </div>
            <div class="field" style="width:140px;">
                <label class="field-label">Cant. por unidad</label>
                <input asp-for="AddBom.QuantityPerUnit" type="number" step="0.01" min="0.01" required />
            </div>
            <button type="submit" class="primary"><i class="fas fa-link"></i> Agregar a ficha</button>
        </form>
    </div>
}

<div class="card">
    <div class="card-title amber"><i class="fas fa-chart-pie"></i> Lista de materiales por producto (BOM)</div>
    @if (!Model.Bom.Any())
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-diagram-project", Title = "Sin fichas técnicas", Text = "Todavía no hay materiales asociados a productos.", ActionText = canEditBom ? "Use el formulario superior para crear la primera ficha." : null }' />
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Producto</th><th>Material</th><th>Cantidad por unidad</th><th>Unidad</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Bom)
                {
                    <tr>
                        <td><strong>@item.ProductName</strong></td>
                        <td>@item.MaterialName</td>
                        <td>@item.QuantityPerUnit</td>
                        <td>@item.UnitDisplay</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card">
    <div class="card-title amber"><i class="fas fa-calculator"></i> Simulación de requerimiento neto</div>
    <form asp-action="Simulate" method="post" class="form-row">
        @Html.AntiForgeryToken()
        <div class="field" style="flex:1;min-width:200px;">
            <label class="field-label">Producto</label>
            <input asp-for="Simulation.ProductName" list="mrp-sim-productos" placeholder="Escriba cualquier producto" maxlength="80" required style="width:100%" />
            <datalist id="mrp-sim-productos">
                @foreach (var name in Model.KnownProducts)
                {
                    <option value="@name"></option>
                }
            </datalist>
        </div>
        <div class="field" style="width:160px;">
            <label class="field-label">Cantidad a fabricar</label>
            <input asp-for="Simulation.Quantity" type="number" step="1" min="1" />
        </div>
        <button type="submit" class="primary"><i class="fas fa-play"></i> Calcular MRP</button>
    </form>
    @if (Model.Result is not null)
    {
        <div class="alert alert-info" style="margin-top:14px;">
            <i class="fas fa-chart-pie"></i>
            <div>
                <strong>MRP para @Model.Result.ProductName (@Model.Result.Quantity uds):</strong><br />
                @if (!Model.Result.Lines.Any())
                {
                    <text>Sin ficha BOM para este producto. Agréguele materiales arriba para calcular requerimientos.</text>
                }
                else
                {
                    foreach (var line in Model.Result.Lines)
                    {
                        <text>
                            <strong>@line.MaterialName:</strong> necesita @line.Required.ToString("0.0") @line.UnitDisplay,
                            disponible @line.Available.ToString("0.0") →
                            @if (line.IsOk)
                            {
                                <span style="color:var(--teal);font-weight:600;">OK</span>
                            }
                            else
                            {
                                <span style="color:var(--red);font-weight:600;">Déficit @line.Deficit.ToString("0.0")</span>
                            }
                            <br />
                        </text>
                    }
                }
            </div>
        </div>
    }
</div>
