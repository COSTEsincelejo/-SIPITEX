@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Olvidé mi contraseña";
    Layout = "_LoginLayout";
}

<div class="card auth-card">
    <div class="card-title"><i class="fas fa-key"></i> Restablecer contraseña</div>
    <p class="auth-hint">Ingrese su correo. Si existe una cuenta activa, le enviaremos un enlace de un solo uso.</p>
    <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="field">
            <label class="field-label" asp-for="Email">Correo</label>
            <input asp-for="Email" type="email" autocomplete="username" required />
        </div>
        <button type="submit" class="primary auth-submit">Enviar enlace</button>
    </form>
    <p class="auth-hint" style="margin-top:1rem;">
        <a asp-action="Login">Volver al inicio de sesión</a>
    </p>
</div>
