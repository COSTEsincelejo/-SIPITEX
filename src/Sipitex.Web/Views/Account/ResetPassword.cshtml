@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Nueva contraseña";
    Layout = "_LoginLayout";
}

<div class="card auth-card">
    <div class="card-title"><i class="fas fa-lock"></i> Elegir nueva contraseña</div>
    <p class="auth-hint">Ingrese el código de 6 dígitos que llegó a su correo y defina una contraseña nueva (mínimo 6 caracteres).</p>
    <form asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="field">
            <label class="field-label" asp-for="Email">Correo</label>
            <input asp-for="Email" type="email" autocomplete="username" required />
        </div>
        <div class="field">
            <label class="field-label" asp-for="Code">Código</label>
            <input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" placeholder="000000" required />
        </div>
        <div class="field">
            <label class="field-label" asp-for="NewPassword">Nueva contraseña</label>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" required />
        </div>
        <div class="field">
            <label class="field-label" asp-for="ConfirmPassword">Confirmar contraseña</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
        </div>
        <button type="submit" class="primary auth-submit">Guardar contraseña</button>
    </form>
    @if (!string.IsNullOrWhiteSpace(Model.Email))
    {
        <form asp-action="ForgotPassword" method="post" style="margin-top:1rem;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Email" value="@Model.Email" />
            <button type="submit" class="ghost auth-submit">Reenviar código</button>
        </form>
    }
    <p class="auth-hint" style="margin-top:1rem;">
        <a asp-action="Login">Volver al inicio de sesión</a>
    </p>
</div>
