@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Nueva contraseña";
    Layout = "_LoginLayout";
}

<div class="card auth-card">
    <div class="card-title"><i class="fas fa-lock"></i> Código y nueva contraseña</div>
    <p class="auth-hint">Si el correo existe, se envió un código de 6 dígitos. Caduca en 15 minutos y es de un solo uso.</p>
    @if (ViewBag.SuccessMessage is string success && !string.IsNullOrWhiteSpace(success))
    {
        <div class="alert alert-success">@success</div>
    }
    <form asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="field">
            <label class="field-label" asp-for="Email">Correo</label>
            <input asp-for="Email" type="email" autocomplete="username" required />
        </div>
        <div class="field">
            <label class="field-label" asp-for="Code">Código</label>
            <input asp-for="Code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="000000" required />
        </div>
        <div class="field">
            <label class="field-label" asp-for="NewPassword">Nueva contraseña</label>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" required />
        </div>
        <div class="field">
            <label class="field-label" asp-for="ConfirmPassword">Confirmar contraseña</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
        </div>
        <button type="submit" class="primary auth-submit">Guardar contraseña</button>
    </form>
    <p class="auth-hint" style="margin-top:1rem;">
        <a asp-action="ForgotPassword">Solicitar otro código</a>
        ·
        <a asp-action="Login">Volver al inicio de sesión</a>
    </p>
</div>
