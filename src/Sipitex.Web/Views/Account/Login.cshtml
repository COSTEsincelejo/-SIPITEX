@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h2>Acceso al sistema</h2>
        <div class="sub">Ingrese sus credenciales para continuar</div>
    </div>
</div>

<div class="card" style="max-width:520px; margin:24px auto;">
    <div class="card-title"><i class="fas fa-right-to-bracket"></i> Inicio de sesión</div>
    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="field">
            <label class="field-label">Correo</label>
            <input asp-for="Email" type="email" placeholder="admin@sipitex.test" required />
        </div>
        <div class="field">
            <label class="field-label">Contraseña</label>
            <input asp-for="Password" type="password" placeholder="Admin123!" required />
        </div>
        <button type="submit" class="primary"><i class="fas fa-sign-in-alt"></i> Entrar</button>
    </form>
</div>
