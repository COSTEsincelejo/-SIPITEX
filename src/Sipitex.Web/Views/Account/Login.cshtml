@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LoginLayout";
}

<div class="card auth-card">
    <div class="card-title"><i class="fas fa-right-to-bracket"></i> Inicio de sesión</div>
    <p class="auth-hint">Ingrese con su cuenta institucional para continuar.</p>
    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="field">
            <label class="field-label" asp-for="Email">Correo</label>
            <input asp-for="Email" type="email" placeholder="usuario@sipitex.test" autocomplete="username" required />
        </div>
        <div class="field">
            <label class="field-label" asp-for="Password">Contraseña</label>
            <input asp-for="Password" type="password" placeholder="••••••••" autocomplete="current-password" required />
        </div>
        <p class="auth-hint" style="margin:.35rem 0 1rem;">
            <a asp-action="ForgotPassword">¿Olvidaste tu contraseña?</a>
        </p>
        <button type="submit" class="primary auth-submit"><i class="fas fa-sign-in-alt"></i> Entrar</button>
    </form>
    @if (ViewBag.SuccessMessage is string success && !string.IsNullOrWhiteSpace(success))
    {
        <div class="alert alert-success" style="margin-top:1rem;">@success</div>
    }
    <details class="auth-demo">
        <summary>Credenciales de demostración</summary>
        <div>Admin: <code>admin@sipitex.test</code> / <code>Admin123!</code></div>
        <div>Instructor: <code>instructor@sipitex.test</code> / <code>Instructor123!</code></div>
        <div>Bodeguero: <code>bodega@sipitex.test</code> / <code>Bodega123!</code></div>
    </details>
</div>
