@model IEnumerable<User>
@{
    ViewData["Title"] = "Usuarios";
    ViewData["Breadcrumb"] = "SIPITEX / Administración / Usuarios";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h2>Gestión de usuarios</h2>
        <div class="sub">Crear, editar y desactivar usuarios del sistema</div>
    </div>
    <a asp-action="CreateUser" class="primary"><i class="fas fa-user-plus"></i> Crear usuario</a>
</div>

@if (TempData["Message"] is string msg)
{
    <div data-toast data-toast-type="success" style="position:absolute;left:-9999px;">@msg</div>
}

<div class="card">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Ficha</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var initial = string.IsNullOrWhiteSpace(u.Nombre) ? "?" : u.Nombre.Substring(0, 1).ToUpperInvariant();
                    <tr>
                        <td>
                            <div class="user-cell">
                                @if (!string.IsNullOrWhiteSpace(u.PhotoPath))
                                {
                                    <img class="avatar-img" src="@u.PhotoPath" alt="" />
                                }
                                else
                                {
                                    <span class="avatar">@initial</span>
                                }
                                <span>@u.Nombre</span>
                            </div>
                        </td>
                        <td>@u.Email</td>
                        <td>@u.Rol</td>
                        <td>@(u.FichaAsignada?.FichaCode ?? "-")</td>
                        <td>
                            <span class="badge @(u.IsActive ? "badge-success" : "badge-danger")">@(u.IsActive ? "Activo" : "Inactivo")</span>
                        </td>
                        <td>
                            <div class="row-actions">
                                <a asp-action="EditUser" asp-route-id="@u.Id" class="btn small ghost">Editar</a>
                                <form asp-action="ToggleUserStatus" method="post"
                                      data-confirm="@(u.IsActive ? "¿Desactivar este usuario?" : "¿Activar este usuario?")">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <input type="hidden" name="isActive" value="@(!u.IsActive)" />
                                    <button type="submit" class="small @(u.IsActive ? "danger" : "ghost")">@(u.IsActive ? "Desactivar" : "Activar")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
