@model UserEditViewModel
@{
    ViewData["Title"] = "Editar usuario";
    ViewData["Breadcrumb"] = "SIPITEX / Administración / Editar usuario";
    Layout = "_Layout";
    var fichas = ViewBag.Fichas as IEnumerable<Ficha> ?? Array.Empty<Ficha>();
    var plantasInventario = ViewBag.PlantasInventario as IEnumerable<PlantaInventario> ?? Array.Empty<PlantaInventario>();
    // El admin principal no se le puede cambiar el rol
    var isAdminUser = string.Equals(Model.Rol, UserRoles.Administrador, StringComparison.OrdinalIgnoreCase);
}

<div class="page-header">
    <div>
        <h2>Editar usuario</h2>
        <div class="sub">Actualice la información del usuario</div>
    </div>
</div>

<div class="card" style="max-width:700px;">
    <form asp-action="EditUser" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="field">
            <label class="field-label" asp-for="Nombre">Nombre</label>
            <input asp-for="Nombre" />
            <span asp-validation-for="Nombre" class="field-error"></span>
        </div>
        <div class="field">
            <label class="field-label" asp-for="Email">Correo</label>
            <input asp-for="Email" type="email" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="field">
            <label class="field-label" asp-for="Password">Nueva contraseña</label>
            <input asp-for="Password" type="password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="field">
            <label class="field-label">Rol</label>
            @if (isAdminUser)
            {
                @* Rol bloqueado: hidden para que siga viajando en el POST *@
                <input asp-for="Rol" type="hidden" />
                <input value="@Model.Rol" readonly class="readonly-input" />
                <p class="hint" style="margin-top:.35rem;">El rol del administrador no se puede cambiar.</p>
            }
            else
            {
                <select asp-for="Rol">
                    @foreach (var rol in UserRoles.CreatableByAdmin)
                    {
                        <option value="@rol">@rol</option>
                    }
                </select>
            }
        </div>
        <div class="field" data-role-field="instructor">
            <label class="field-label">Ficha asignada</label>
            <select asp-for="FichaAsignadaId">
                <option value="">Sin asignar</option>
                @foreach (var ficha in fichas)
                {
                    <option value="@ficha.Id">@ficha.NumeroGrupo - @ficha.ProcessName</option>
                }
            </select>
        </div>
        <div class="field" data-role-field="plantas">
            @{
                var plantasObligatorias = string.Equals(Model.Rol, UserRoles.EncargadoDeBodega, StringComparison.OrdinalIgnoreCase);
            }
            <label class="field-label" for="PlantaInventarioIds">
                Plantas de inventario
                <span data-plantas-marca class="field-req" @(plantasObligatorias ? null : "hidden")>*</span>
                <span data-plantas-opcional class="field-optional" @(plantasObligatorias ? "hidden" : null)>(opcional)</span>
            </label>
            <select name="PlantaInventarioIds" id="PlantaInventarioIds" multiple size="4" data-plantas-select
                    aria-required="@(plantasObligatorias ? "true" : "false")"
                    @(plantasObligatorias ? "required" : null)>
                @foreach (var plantaInventario in plantasInventario)
                {
                    if ((Model.PlantaInventarioIds ?? []).Contains(plantaInventario.Id))
                    {
                        <option value="@plantaInventario.Id" selected>@plantaInventario.Nombre</option>
                    }
                    else
                    {
                        <option value="@plantaInventario.Id">@plantaInventario.Nombre</option>
                    }
                }
            </select>
            <span asp-validation-for="PlantaInventarioIds" class="field-error"></span>
            <p class="hint" style="margin-top:.35rem;">Mantenga Ctrl (o Cmd) para marcar varias. El encargado de bodega necesita al menos una. Si cambia el rol y deja plantas marcadas, se conservan.</p>
        </div>
        <div class="field">
            <label class="field-label">Permisos extendidos</label>
            <div class="sub" style="margin-bottom:.5rem;">Opcional: otorga capacidades extra según el rol (p. ej. Instructor).</div>
            @foreach (var (key, label) in ExtendedPermissions.Catalog)
            {
                <label style="display:flex;align-items:center;gap:.5rem;margin:.35rem 0;">
                    <input type="checkbox"
                           name="SelectedPermissions"
                           value="@key"
                           @(Model.SelectedPermissions.Contains(key) ? "checked" : null) />
                    <span>@label <code style="font-size:.8em;">@key</code></span>
                </label>
            }
        </div>
        <div class="field">
            <label class="field-label">Activo</label>
            <input asp-for="IsActive" type="checkbox" />
        </div>
        <button type="submit" class="primary">Guardar cambios</button>
        <a asp-action="Users" class="small ghost">Cancelar</a>
    </form>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<partial name="_UserRolCamposScript" />
}
