@model ProfileViewModel
@{
    ViewData["Title"] = "Mi perfil";
    ViewData["Breadcrumb"] = "SIPITEX / Mi perfil";
    Layout = "_Layout";
    // Inicial para el avatar cuando no hay foto
    var initial = string.IsNullOrWhiteSpace(Model.Nombre) ? "?" : Model.Nombre.Substring(0, 1).ToUpperInvariant();
}

<div class="page-header">
    <div>
        <h2>Mi perfil</h2>
        <div class="sub">Administre su foto, la descripción de sus funciones, datos de contacto y contraseña. El rol lo asigna el administrador.</div>
    </div>
</div>

<div class="card profile-card">
    <form asp-action="Profile" method="post" enctype="multipart/form-data" class="profile-form">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="Rol" type="hidden" />
        <input asp-for="PhotoPath" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="profile-photo-block">
            <div class="profile-photo-preview" id="photoPreview">
                @if (!string.IsNullOrWhiteSpace(Model.PhotoPath))
                {
                    <img src="@Model.PhotoPath" alt="Foto de perfil de @Model.Nombre" />
                }
                else
                {
                    <span class="profile-photo-initial">@initial</span>
                }
            </div>
            <div class="profile-photo-actions">
                <label class="field-label">Foto de perfil <span class="field-optional">(opcional)</span></label>
                <p class="hint">Opcional. Solo se guarda si usted la carga. JPG, PNG o WEBP · máximo 2 MB. No se usa para reconocimiento facial.</p>
                <input type="file" name="photo" id="photoInput" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                @if (!string.IsNullOrWhiteSpace(Model.PhotoPath))
                {
                    <label class="permission-item profile-remove-photo">
                        <input asp-for="RemovePhoto" type="checkbox" />
                        <span>Quitar foto actual</span>
                    </label>
                }
            </div>
        </div>

        <div class="field">
            <label class="field-label" asp-for="Nombre">Nombre</label>
            <input asp-for="Nombre" required maxlength="120" />
            <span asp-validation-for="Nombre" class="field-error"></span>
        </div>

        <div class="field">
            <label class="field-label" asp-for="Email">Correo</label>
            <input asp-for="Email" type="email" required maxlength="160" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="field">
            <label class="field-label">Rol</label>
            <input value="@Model.Rol" readonly class="readonly-input" />
        </div>

        <div class="field">
            <label class="field-label" for="FuncionDescripcion">Descripción de mis funciones <span class="field-optional">(opcional)</span></label>
            <textarea asp-for="FuncionDescripcion" rows="4" maxlength="800" placeholder="Ej.: Responsable de inventario y despacho de materiales en planta de inventario; apoyo en conteos y alertas de stock."></textarea>
            <p class="hint">Opcional. Solo se guarda si usted la escribe (máx. 800 caracteres).</p>
            <span asp-validation-for="FuncionDescripcion" class="field-error"></span>
        </div>

        <div class="field-row">
            <div class="field">
                <label class="field-label" asp-for="NewPassword">Nueva contraseña</label>
                <input asp-for="NewPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label class="field-label" asp-for="ConfirmPassword">Confirmar contraseña</label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
        </div>
        <p class="hint">Deje las contraseñas en blanco si no desea cambiarlas. También puede usar «¿Olvidó su contraseña?» en el inicio de sesión.</p>

        <div class="form-actions">
            <button type="submit" class="primary"><i class="fas fa-floppy-disk"></i> Guardar perfil</button>
        </div>
    </form>
</div>

<div class="card">
    <div class="card-title"><i class="fas fa-shield-halved"></i> Mis datos</div>
    <p>Estos son los datos personales que SIPITEX guarda de su cuenta. Consultarlos aquí es gratuito.</p>
    <ul>
        <li>Nombre: @Model.Nombre</li>
        <li>Correo: @Model.Email</li>
        <li>Rol: @Model.Rol</li>
        <li>Ficha asignada: @Model.FichaTexto</li>
        <li>Plantas de inventario: @Model.PlantasTexto</li>
        <li>Descripción de funciones: @(string.IsNullOrWhiteSpace(Model.FuncionDescripcion) ? "No ha cargado una (es opcional)." : Model.FuncionDescripcion)</li>
        <li>Foto de perfil: @(string.IsNullOrWhiteSpace(Model.PhotoPath) ? "No ha cargado una (es opcional)." : "Sí, cargada por usted.")</li>
    </ul>
    <p class="hint">Puede corregir el nombre, el correo, la foto y la descripción en el formulario de arriba. El rol, la ficha y las plantas los asigna el administrador.</p>

    <h3>Aceptación de la política</h3>
    @if (Model.Aceptaciones.Count == 0)
    {
        <p>Todavía no hay una aceptación registrada de la política de tratamiento de datos.</p>
    }
    else
    {
        <ul>
            @foreach (var aceptacion in Model.Aceptaciones)
            {
                var ip = string.IsNullOrWhiteSpace(aceptacion.DireccionIp) ? "" : " · IP " + aceptacion.DireccionIp;
                <li>
                    Versión <strong>@aceptacion.VersionPolitica</strong>,
                    el @aceptacion.AceptadaEnUtc.ToString("yyyy-MM-dd HH:mm") UTC@ip.
                    <a asp-controller="Privacidad" asp-action="Index" asp-route-version="@aceptacion.VersionPolitica">Ver esa versión</a>
                </li>
            }
        </ul>
        <p><a asp-controller="Privacidad" asp-action="Descargar">Descargar constancia y texto aceptado</a></p>
    }

    <h3>Solicitudes</h3>
    <p>Puede pedir la rectificación, la supresión o la revocatoria. La solicitud queda en la auditoría con la fecha, el tipo y el estado «recibida». Si hay correo de contacto, se avisa al responsable.</p>
    <p>Este pedido se trata como reclamo: la respuesta llega en máximo 15 días hábiles, prorrogables 8 más si le avisan los motivos. Si el reclamo está incompleto, le pedirán completarlo en 5 días; si pasan 2 meses sin su respuesta, se entiende desistido. Puede acudir a la SIC solo después de agotar este trámite. Consultar los datos es gratuito. Una consulta que no sea este formulario se responde en máximo 10 días hábiles, prorrogables 5 más.</p>
    <form asp-controller="Privacidad" asp-action="Solicitar" method="post">
        <div class="field">
            <label class="field-label" for="tipoSolicitud">Qué solicita</label>
            <select id="tipoSolicitud" name="Tipo">
                <option value="rectificacion">Rectificar mis datos</option>
                <option value="supresion">Suprimir mis datos</option>
                <option value="revocatoria">Revocar la autorización</option>
            </select>
        </div>
        <div class="field">
            <label class="field-label" for="mensajeSolicitud">Detalle</label>
            <textarea id="mensajeSolicitud" name="Mensaje" rows="3" maxlength="800" required placeholder="Indique qué dato hay que corregir, por qué pide la supresión o la revocatoria."></textarea>
        </div>
        <div class="form-actions">
            <button type="submit" class="ghost">Enviar solicitud</button>
        </div>
    </form>
</div>

@section Scripts {
<script>
(() => {
  const input = document.getElementById('photoInput');
  const preview = document.getElementById('photoPreview');
  if (!input || !preview) return;
  input.addEventListener('change', () => {
    const file = input.files && input.files[0];
    if (!file) return;
    const url = URL.createObjectURL(file);
    preview.innerHTML = `<img src="${url}" alt="Vista previa" />`;
  });
})();
</script>
}
