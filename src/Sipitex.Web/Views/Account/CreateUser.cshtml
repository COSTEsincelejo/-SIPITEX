@model UserEditViewModel
@{
    ViewData["Title"] = "Crear usuario";
    ViewData["Breadcrumb"] = "SIPITEX / Administración / Crear usuario";
    Layout = "_Layout";
    var fichas = ViewBag.Fichas as IEnumerable<Ficha> ?? Array.Empty<Ficha>();
}

<div class="page-header">
    <div>
        <h2>Crear usuario</h2>
        <div class="sub">Solo el administrador puede crear cuentas de Instructor o Bodeguero. Ellos podrán luego actualizar su foto y contraseña en Mi perfil.</div>
    </div>
</div>

<div class="card" style="max-width:700px;">
    <form asp-action="CreateUser" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="field">
            <label class="field-label">Nombre</label>
            <input asp-for="Nombre" required />
        </div>
        <div class="field">
            <label class="field-label">Correo</label>
            <input asp-for="Email" type="email" required />
        </div>
        <div class="field">
            <label class="field-label">Contraseña temporal</label>
            <input asp-for="Password" type="password" required />
            <p class="hint" style="margin-top:.35rem;">El usuario podrá cambiarla desde Mi perfil o con recuperación de contraseña.</p>
        </div>
        <div class="field">
            <label class="field-label">Rol</label>
            <select asp-for="Rol">
                @foreach (var rol in UserRoles.CreatableByAdmin)
                {
                    <option value="@rol">@rol</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="field-label">Ficha asignada</label>
            <select asp-for="FichaAsignadaId">
                <option value="">Sin asignar</option>
                @foreach (var ficha in fichas)
                {
                    <option value="@ficha.Id">@ficha.FichaCode - @ficha.ProcessName</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="field-label">Permisos extendidos</label>
            <div class="sub" style="margin-bottom:.5rem;">Opcional: otorga capacidades extra según el rol (p. ej. Instructor).</div>
            @foreach (var (key, label) in ExtendedPermissions.Catalog)
            {
                <label style="display:flex;align-items:center;gap:.5rem;margin:.35rem 0;">
                    <input type="checkbox"
                           name="SelectedPermissions"
                           value="@key"
                           @(Model.SelectedPermissions.Contains(key) ? "checked" : null) />
                    <span>@label <code style="font-size:.8em;">@key</code></span>
                </label>
            }
        </div>
        <button type="submit" class="primary">Guardar</button>
        <a asp-action="Users" class="small ghost">Cancelar</a>
    </form>
</div>
