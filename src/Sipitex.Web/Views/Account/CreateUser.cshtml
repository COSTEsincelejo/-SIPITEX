@model UserEditViewModel
@{
    ViewData["Title"] = "Crear usuario";
    ViewData["Breadcrumb"] = "SIPITEX / Administración / Crear usuario";
    Layout = "_Layout";
    var fichas = ViewBag.Fichas as IEnumerable<Ficha> ?? Array.Empty<Ficha>();
}

<div class="page-header">
    <div>
        <h2>Crear usuario</h2>
        <div class="sub">Registre un usuario y asígnele permisos (solo el administrador puede otorgarlos)</div>
    </div>
</div>

<div class="card" style="max-width:760px;">
    <form asp-action="CreateUser" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="field">
            <label class="field-label">Nombre</label>
            <input asp-for="Nombre" required />
        </div>
        <div class="field">
            <label class="field-label">Correo</label>
            <input asp-for="Email" type="email" required />
        </div>
        <div class="field">
            <label class="field-label">Contraseña</label>
            <input asp-for="Password" type="password" required />
        </div>
        <div class="field">
            <label class="field-label">Rol</label>
            <select asp-for="Rol">
                <option value="Administrador">Administrador</option>
                <option value="Instructor">Instructor</option>
                <option value="Bodeguero">Bodeguero</option>
            </select>
        </div>
        <div class="field">
            <label class="field-label">Ficha asignada</label>
            <select asp-for="FichaAsignadaId">
                <option value="">Sin asignar</option>
                @foreach (var ficha in fichas)
                {
                    <option value="@ficha.Id">@ficha.FichaCode - @ficha.ProcessName</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="field-label">Permisos otorgados por el administrador</label>
            <div class="permission-grid">
                @foreach (var perm in UserPermissions.Catalog)
                {
                    <label class="permission-item">
                        <input type="checkbox" name="SelectedPermissions" value="@perm.Code"
                               @(Model.SelectedPermissions.Contains(perm.Code) ? "checked" : null) />
                        <span>
                            <strong>@perm.Label</strong>
                            <small>@perm.Hint</small>
                        </span>
                    </label>
                }
            </div>
        </div>
        <button type="submit" class="primary">Guardar</button>
        <a asp-action="Users" class="small ghost">Cancelar</a>
    </form>
</div>
