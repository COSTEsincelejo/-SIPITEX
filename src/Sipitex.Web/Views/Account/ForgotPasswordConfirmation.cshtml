@{
    ViewData["Title"] = "Revisa tu correo";
    Layout = "_LoginLayout"; // layout simple sin menú lateral
}

<div class="card auth-card">
    <div class="card-title"><i class="fas fa-envelope"></i> Solicitud recibida</div>
    <p class="auth-hint">
        Si el correo existe en SIPITEX, te enviamos un enlace para restablecer la contraseña.
        El enlace vence en 1 hora y solo se puede usar una vez.
    </p>
    <p class="auth-hint" style="margin-top:1rem;">
        <a asp-action="Login">Volver al inicio de sesión</a>
    </p>
</div>
