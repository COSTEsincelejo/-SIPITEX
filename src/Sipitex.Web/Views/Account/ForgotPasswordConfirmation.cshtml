@{
    ViewData["Title"] = "Revisa tu correo";
    Layout = "_LoginLayout"; // layout simple sin menú lateral
    var email = ViewBag.Email as string;
}

<div class="card auth-card">
    <div class="card-title"><i class="fas fa-envelope"></i> Solicitud recibida</div>
    <p class="auth-hint">
        Si el correo existe en SIPITEX, te enviamos un código de 6 dígitos para restablecer la contraseña.
        El código vence en 15 minutos y solo se puede usar una vez. Pedir otro código anula el anterior.
    </p>
    @if (!string.IsNullOrWhiteSpace(email))
    {
        <p class="auth-hint" style="margin-top:1rem;">
            <a asp-action="ResetPassword" asp-route-email="@email">Ingresar código</a>
        </p>
        <form asp-action="ForgotPassword" method="post" style="margin-top:1rem;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Email" value="@email" />
            <button type="submit" class="ghost auth-submit">Reenviar código</button>
        </form>
    }
    else
    {
        <p class="auth-hint" style="margin-top:1rem;">
            <a asp-action="ResetPassword">Ingresar código</a>
        </p>
    }
    <p class="auth-hint" style="margin-top:1rem;">
        <a asp-action="Login">Volver al inicio de sesión</a>
    </p>
</div>
