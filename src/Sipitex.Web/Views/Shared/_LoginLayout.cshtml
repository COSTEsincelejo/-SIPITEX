<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SIPITEX · @ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="~/css/sipitex.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-shell">
        <div class="auth-brand">
            <div class="mark">
                <div class="mark-icon">SX</div>
                <div>
                    <h1>SIPITEX</h1>
                    <p>Sistema Integrado de Producción e Inventario Textil</p>
                </div>
            </div>
        </div>
        <div class="auth-panel">
            @RenderBody()
        </div>
        <p class="auth-foot">CMTC · SENA · ADSO</p>
    </div>
</body>
</html>
