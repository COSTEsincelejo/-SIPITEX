@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    ViewData["Breadcrumb"] = "SIPITEX / Error";
}

<div class="page-header">
    <div>
        <h2>No se pudo completar la operación</h2>
        <div class="sub">Ocurrió un error inesperado.</div>
    </div>
</div>

<section class="card">
    @if (Model.ShowCodigoError)
    {
        <p>Si el problema persiste, informe el código <strong>@Model.CodigoError</strong>.</p>
    }
    else
    {
        <p>Si el problema persiste, avise a coordinación.</p>
    }
</section>
