@using System.Security.Claims
@{
    // Sacamos controller y action de la ruta actual para marcar el menú activo
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    // Devuelve la clase CSS si el ítem del menú coincide con el controlador actual
    string NavClass(string name) => controller.Equals(name, StringComparison.OrdinalIgnoreCase) ? "nav-item active" : "nav-item";
    // Para resaltar sub-opciones de Account (usuarios, perfil, etc.)
    bool IsAccountAction(params string[] actions) =>
        controller.Equals("Account", StringComparison.OrdinalIgnoreCase)
        && actions.Any(a => action.Equals(a, StringComparison.OrdinalIgnoreCase));
    var title = ViewData["Title"]?.ToString() ?? "SIPITEX";
    var breadcrumb = ViewData["Breadcrumb"]?.ToString() ?? "SIPITEX";
    // Datos del usuario logueado para la barra superior
    var user = User.Identity?.IsAuthenticated == true ? User : null;
    var role = user?.FindFirstValue(ClaimTypes.Role) ?? "Invitado";
    var name = user?.FindFirstValue(ClaimTypes.Name) ?? "Usuario";
    var photo = user?.FindFirstValue("photo");
    // Mensajes que vienen del controlador vía TempData (toast)
    var toastMessage = TempData["Message"] as string;
    var toastSuccess = TempData["IsSuccess"] as bool?;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <title>SIPITEX · @title</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="~/css/sipitex.css" asp-append-version="true" />
</head>
<body>
<div class="shell">
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="mark">
                <div class="mark-icon">
                    <img src="~/img/logo-mark.svg" asp-append-version="true" alt="SIPITEX" />
                </div>
                <div><h1>SIPITEX</h1></div>
            </div>
            <p>Sistema Integrado de Aprendizaje Producción<br>e Inventario Textil · CMTC SENA</p>
        </div>
        <div class="sidebar-nav">
        <nav class="nav-group">
            <div class="nav-group-label">Operación</div>
            <a class="@NavClass("Ordenes")" asp-controller="Ordenes" asp-action="Index"><i class="fas fa-clipboard-list"></i> Órdenes de producción</a>
            <a class="@NavClass("Mrp")" asp-controller="Mrp" asp-action="Index"><i class="fas fa-diagram-project"></i> MRP / Materiales</a>
            @* Inventario general: Admin y Bodeguero. Instructor consulta materiales vía MRP. *@
            @if (User.IsInRole("Administrador") || User.IsInRole("Bodeguero"))
            {
                <a class="@NavClass("Inventario")" asp-controller="Inventario" asp-action="Index"><i class="fas fa-boxes-stacked"></i> Inventario</a>
            }
            @* Catálogo de bodegas: solo Administrador (BodegasController). *@
            @if (User.IsInRole("Administrador"))
            {
                <a class="@NavClass("Bodegas")" asp-controller="Bodegas" asp-action="Index"><i class="fas fa-warehouse"></i> Bodegas</a>
            }
            @* Cola de SolicitudMaterial solo Bodeguero *@
            @if (User.IsInRole("Bodeguero"))
            {
                <a class="@NavClass("BodegaSolicitudes")" asp-controller="BodegaSolicitudes" asp-action="Index"><i class="fas fa-truck-ramp-box"></i> Solicitudes de materiales</a>
                <a class="@NavClass("BodegaOrdenes")" asp-controller="BodegaOrdenes" asp-action="Index"><i class="fas fa-clipboard-check"></i> Materiales de órdenes</a>
                <a class="@(controller.Equals("BodegaOrdenes", StringComparison.OrdinalIgnoreCase) && action.Equals("Reingreso", StringComparison.OrdinalIgnoreCase) ? "nav-item active" : "nav-item")"
                   asp-controller="BodegaOrdenes" asp-action="Reingreso"><i class="fas fa-rotate-left"></i> Reingreso desde etapas</a>
            }
            @if (User.IsInRole("Administrador") || User.IsInRole("Bodeguero"))
            {
                <a class="@(controller.Equals("Inventario", StringComparison.OrdinalIgnoreCase) && action.Equals("Movimientos", StringComparison.OrdinalIgnoreCase) ? "nav-item active" : "nav-item")"
                   asp-controller="Inventario" asp-action="Movimientos"><i class="fas fa-clock-rotate-left"></i> Movimientos de stock</a>
            }
            @* Fichas y calidad solo para admin e instructor *@
            @if (User.IsInRole("Administrador") || User.IsInRole("Instructor"))
            {
                <a class="@NavClass("Fichas")" asp-controller="Fichas" asp-action="Index"><i class="fas fa-people-group"></i> Fichas & producción</a>
                <a class="@NavClass("SolicitudesMaterial")" asp-controller="SolicitudesMaterial" asp-action="Index"><i class="fas fa-clipboard-list"></i> Mis solicitudes</a>
                <a class="@(controller.Equals("SolicitudesMaterial", StringComparison.OrdinalIgnoreCase) && action.Equals("SolicitarInsumos", StringComparison.OrdinalIgnoreCase) ? "nav-item active" : "nav-item")"
                   asp-controller="SolicitudesMaterial" asp-action="SolicitarInsumos"><i class="fas fa-comment-dots"></i> Solicitar insumos</a>
                <a class="@NavClass("Calidad")" asp-controller="Calidad" asp-action="Index"><i class="fas fa-clipboard-check"></i> Control de calidad</a>
            }
        </nav>
        <nav class="nav-group">
            <div class="nav-group-label">Análisis</div>
            <a class="@NavClass("Estadisticas")" asp-controller="Estadisticas" asp-action="Index"><i class="fas fa-chart-line"></i> Estadísticas</a>
            <a class="@NavClass("Reportes")" asp-controller="Reportes" asp-action="Index"><i class="fas fa-file-export"></i> Reportes</a>
            <a class="@NavClass("Alertas")" asp-controller="Alertas" asp-action="Index"><i class="fas fa-bell"></i> Alertas</a>
            @* Gestión de usuarios solo admin *@
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
            {
                <a class="@(IsAccountAction("Users", "CreateUser", "EditUser") ? "nav-item active" : "nav-item")"
                   asp-controller="Account" asp-action="Users"><i class="fas fa-users-gear"></i> Usuarios</a>
            }
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="@(IsAccountAction("Profile") ? "nav-item active" : "nav-item")"
                   asp-controller="Account" asp-action="Profile"><i class="fas fa-user"></i> Mi perfil</a>
            }
        </nav>
        </div>
        <div class="sidebar-foot">SIPITEX v1.0 · .NET MVC<br>CMTC · SENA · ADSO</div>
    </aside>
    <div class="sidebar-backdrop" id="sidebarBackdrop" hidden></div>
    <div class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button type="button"
                        class="menu-toggle"
                        id="menuToggle"
                        aria-label="Abrir o cerrar menú"
                        aria-controls="sidebar"
                        aria-expanded="true">
                    <i class="fas fa-bars" aria-hidden="true"></i>
                </button>
                <div>
                    <h2>@title</h2>
                    <div class="breadcrumb">@breadcrumb</div>
                </div>
            </div>
            @* Buscador global: módulos (JS) + entidades (/api/busqueda) *@
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="topbar-search" id="globalSearch" data-search-api="@Url.Content("~/api/busqueda")">
                    <div class="search-field">
                        <i class="fas fa-magnifying-glass search-icon" aria-hidden="true"></i>
                        <input type="search"
                               id="globalSearchInput"
                               class="search-input"
                               placeholder="Buscar en SIPITEX..."
                               autocomplete="off"
                               aria-label="Buscar en SIPITEX"
                               aria-autocomplete="list"
                               aria-controls="globalSearchResults"
                               aria-expanded="false" />
                    </div>
                    <div class="search-dropdown" id="globalSearchResults" role="listbox" hidden></div>
                </div>
            }
            <div class="topbar-right">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="icon-btn" asp-controller="Alertas" asp-action="Index" title="Alertas" aria-label="Alertas">
                        <i class="fas fa-bell"></i>
                    </a>
                    <a class="role-chip role-chip-link" asp-controller="Account" asp-action="Profile" title="Mi perfil" aria-label="Ir a mi perfil">
                        @* Avatar con foto o inicial del nombre *@
                        @if (!string.IsNullOrWhiteSpace(photo))
                        {
                            <img class="avatar avatar-img" src="@photo" alt="" />
                        }
                        else
                        {
                            <div class="avatar">@(string.IsNullOrEmpty(name) ? "?" : name.Substring(0, 1).ToUpper())</div>
                        }
                        <span class="role-text">@name · @role</span>
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ghost small"><i class="fas fa-right-from-bracket"></i> Salir</button>
                    </form>
                }
                else
                {
                    <a class="btn primary small" asp-controller="Account" asp-action="Login"><i class="fas fa-right-to-bracket"></i> Entrar</a>
                }
            </div>
        </header>
        <main class="content">
            @* Toast oculto que site.js lee para mostrar notificaciones *@
            @if (!string.IsNullOrWhiteSpace(toastMessage))
            {
                <div data-toast data-toast-type="@(toastSuccess == false ? "danger" : "success")" class="visually-hidden" style="position:absolute;left:-9999px;">@toastMessage</div>
            }
            @RenderBody()
            <footer class="site-footer">SIPITEX — Sistema Integrado de Aprendizaje Producción e Inventario Textil · CMTC · SENA ADSO</footer>
        </main>
    </div>
</div>
<div id="toastHost" class="toast-host" aria-live="polite"></div>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
