@using System.Security.Claims
@{
    // Sacamos controller y action de la ruta actual para marcar el menú activo
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool IsCtrl(string name) =>
        controller.Equals(name, StringComparison.OrdinalIgnoreCase);

    bool IsAct(string name) =>
        action.Equals(name, StringComparison.OrdinalIgnoreCase);

    // Ítem activo por controlador (cualquier acción), salvo exclusiones
    string NavClass(string name, params string[] exceptActions)
    {
        if (!IsCtrl(name)) return "nav-item";
        if (exceptActions.Length > 0 && exceptActions.Any(IsAct)) return "nav-item";
        return "nav-item active";
    }

    // Ítem activo por controlador + acción exacta
    string NavClassExact(string name, string act) =>
        IsCtrl(name) && IsAct(act) ? "nav-item active" : "nav-item";

    // Account: resaltar sub-opciones (usuarios, perfil, etc.)
    bool IsAccountAction(params string[] actions) =>
        IsCtrl("Account") && actions.Any(IsAct);

    string AccountNavClass(params string[] actions) =>
        IsAccountAction(actions) ? "nav-item active" : "nav-item";

    var title = ViewData["Title"]?.ToString() ?? "SIPITEX";
    var breadcrumbRaw = ViewData["Breadcrumb"]?.ToString() ?? "SIPITEX";
    var breadcrumbParts = breadcrumbRaw
        .Split('/', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);

    // Datos del usuario logueado para la barra superior / sidebar
    var user = User.Identity?.IsAuthenticated == true ? User : null;
    var role = user?.FindFirstValue(ClaimTypes.Role) ?? "Invitado";
    var name = user?.FindFirstValue(ClaimTypes.Name) ?? "Usuario";
    var photo = user?.FindFirstValue("photo");

    var isAdmin = User.IsInRole("Administrador");
    var isBodeguero = User.IsInRole("Bodeguero");
    var isInstructor = User.IsInRole("Instructor");
    var canInventario = isAdmin || isBodeguero;
    var canProduccionDocente = isAdmin || isInstructor;

    // Mensajes que vienen del controlador vía TempData (toast)
    var toastMessage = TempData["Message"] as string;
    var toastSuccess = TempData["IsSuccess"] as bool?;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <title>SIPITEX · @title</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="~/css/sipitex.css" asp-append-version="true" />
</head>
<body data-role="@role">
<div class="shell">
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <a class="mark mark-link" asp-controller="Home" asp-action="Index" title="Ir al inicio">
                <div class="mark-icon">
                    <img src="~/img/logo-mark.svg" asp-append-version="true" alt="SIPITEX" />
                </div>
                <div><h1>SIPITEX</h1></div>
            </a>
            <p>Sistema Integrado de Aprendizaje Producción<br>e Inventario Textil · CMTC SENA</p>
            @if (user != null)
            {
                <div class="sidebar-session" title="@name · @role">
                    <span class="sidebar-role-pill">@role</span>
                    <span class="sidebar-session-name">@name</span>
                </div>
            }
        </div>
        <div class="sidebar-nav">
        <nav class="nav-group" aria-label="Inicio">
            <a class="@NavClass("Home")" asp-controller="Home" asp-action="Index"><i class="fas fa-house"></i> Inicio</a>
        </nav>
        <nav class="nav-group" aria-label="Operación">
            <div class="nav-group-label">Operación</div>
            <a class="@NavClass("Ordenes")" asp-controller="Ordenes" asp-action="Index"><i class="fas fa-clipboard-list"></i> Órdenes de producción</a>
            <a class="@NavClass("Mrp")" asp-controller="Mrp" asp-action="Index"><i class="fas fa-diagram-project"></i> MRP / Materiales</a>
            @* Inventario general: Admin y Bodeguero. Instructor consulta materiales vía MRP. *@
            @if (canInventario)
            {
                <a class="@NavClass("Inventario", "Movimientos")" asp-controller="Inventario" asp-action="Index"><i class="fas fa-boxes-stacked"></i> Inventario</a>
                <a class="@NavClassExact("Inventario", "Movimientos")" asp-controller="Inventario" asp-action="Movimientos"><i class="fas fa-clock-rotate-left"></i> Movimientos de stock</a>
            }
            @* Cola de SolicitudMaterial y entregas: solo Bodeguero *@
            @if (isBodeguero)
            {
                <a class="@NavClass("BodegaSolicitudes")" asp-controller="BodegaSolicitudes" asp-action="Index"><i class="fas fa-truck-ramp-box"></i> Solicitudes de materiales</a>
                <a class="@NavClass("BodegaOrdenes", "Reingreso")" asp-controller="BodegaOrdenes" asp-action="Index"><i class="fas fa-clipboard-check"></i> Materiales de órdenes</a>
                <a class="@NavClassExact("BodegaOrdenes", "Reingreso")" asp-controller="BodegaOrdenes" asp-action="Reingreso"><i class="fas fa-rotate-left"></i> Reingreso desde etapas</a>
            }
            @* Fichas, solicitudes propias y calidad: Admin e Instructor *@
            @if (canProduccionDocente)
            {
                <a class="@NavClass("Fichas")" asp-controller="Fichas" asp-action="Index"><i class="fas fa-people-group"></i> Fichas & producción</a>
                <a class="@NavClass("SolicitudesMaterial")" asp-controller="SolicitudesMaterial" asp-action="Index"><i class="fas fa-clipboard-list"></i> Mis solicitudes</a>
                <a class="@NavClass("Calidad")" asp-controller="Calidad" asp-action="Index"><i class="fas fa-clipboard-check"></i> Control de calidad</a>
            }
        </nav>
        <nav class="nav-group" aria-label="Análisis">
            <div class="nav-group-label">Análisis</div>
            <a class="@NavClass("Estadisticas")" asp-controller="Estadisticas" asp-action="Index"><i class="fas fa-chart-line"></i> Estadísticas</a>
            <a class="@NavClass("Reportes")" asp-controller="Reportes" asp-action="Index"><i class="fas fa-file-export"></i> Reportes</a>
            <a class="@NavClass("Alertas")" asp-controller="Alertas" asp-action="Index"><i class="fas fa-bell"></i> Alertas</a>
        </nav>
        <nav class="nav-group" aria-label="Cuenta">
            <div class="nav-group-label">Cuenta</div>
            @if (isAdmin)
            {
                <a class="@AccountNavClass("Users", "CreateUser", "EditUser")"
                   asp-controller="Account" asp-action="Users"><i class="fas fa-users-gear"></i> Usuarios</a>
            }
            @if (user != null)
            {
                <a class="@AccountNavClass("Profile")"
                   asp-controller="Account" asp-action="Profile"><i class="fas fa-user"></i> Mi perfil</a>
            }
        </nav>
        </div>
        <div class="sidebar-foot">SIPITEX v1.0 · .NET MVC<br>CMTC · SENA · ADSO</div>
    </aside>
    <div class="sidebar-backdrop" id="sidebarBackdrop" hidden></div>
    <div class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button type="button"
                        class="menu-toggle"
                        id="menuToggle"
                        aria-label="Abrir o cerrar menú"
                        aria-controls="sidebar"
                        aria-expanded="true">
                    <i class="fas fa-bars" aria-hidden="true"></i>
                </button>
                <div class="topbar-context">
                    <h2>@title</h2>
                    <nav class="breadcrumb" aria-label="Ubicación">
                        @for (var i = 0; i < breadcrumbParts.Length; i++)
                        {
                            var part = breadcrumbParts[i];
                            var isLast = i == breadcrumbParts.Length - 1;
                            if (i == 0 && part.Equals("SIPITEX", StringComparison.OrdinalIgnoreCase))
                            {
                                <a class="crumb crumb-root" asp-controller="Home" asp-action="Index">SIPITEX</a>
                            }
                            else if (isLast)
                            {
                                <span class="crumb crumb-current" aria-current="page">@part</span>
                            }
                            else
                            {
                                <span class="crumb">@part</span>
                            }
                            if (!isLast)
                            {
                                <span class="crumb-sep" aria-hidden="true">/</span>
                            }
                        }
                    </nav>
                </div>
            </div>
            @* Buscador global: módulos filtrados por rol (data-role) + entidades (/api/busqueda) *@
            @if (user != null)
            {
                <div class="topbar-search" id="globalSearch"
                     data-search-api="@Url.Content("~/api/busqueda")"
                     data-role="@role">
                    <div class="search-field">
                        <i class="fas fa-magnifying-glass search-icon" aria-hidden="true"></i>
                        <input type="search"
                               id="globalSearchInput"
                               class="search-input"
                               placeholder="Buscar en SIPITEX..."
                               autocomplete="off"
                               aria-label="Buscar en SIPITEX"
                               aria-autocomplete="list"
                               aria-controls="globalSearchResults"
                               aria-expanded="false" />
                    </div>
                    <div class="search-dropdown" id="globalSearchResults" role="listbox" hidden></div>
                </div>
            }
            <div class="topbar-right">
                @if (user != null)
                {
                    <a class="icon-btn" asp-controller="Alertas" asp-action="Index" title="Alertas" aria-label="Alertas">
                        <i class="fas fa-bell"></i>
                    </a>
                    <a class="role-chip role-chip-link" asp-controller="Account" asp-action="Profile" title="Mi perfil" aria-label="Ir a mi perfil">
                        @if (!string.IsNullOrWhiteSpace(photo))
                        {
                            <img class="avatar avatar-img" src="@photo" alt="" />
                        }
                        else
                        {
                            <div class="avatar">@(string.IsNullOrEmpty(name) ? "?" : name.Substring(0, 1).ToUpper())</div>
                        }
                        <span class="role-text"><span class="role-name">@name</span> <span class="role-sep">·</span> <span class="role-label">@role</span></span>
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ghost small"><i class="fas fa-right-from-bracket"></i> Salir</button>
                    </form>
                }
                else
                {
                    <a class="btn primary small" asp-controller="Account" asp-action="Login"><i class="fas fa-right-to-bracket"></i> Entrar</a>
                }
            </div>
        </header>
        <main class="content">
            @* Toast oculto que site.js lee para mostrar notificaciones *@
            @if (!string.IsNullOrWhiteSpace(toastMessage))
            {
                <div data-toast data-toast-type="@(toastSuccess == false ? "danger" : "success")" class="visually-hidden" style="position:absolute;left:-9999px;">@toastMessage</div>
            }
            @RenderBody()
            <footer class="site-footer">SIPITEX — Sistema Integrado de Aprendizaje Producción e Inventario Textil · CMTC · SENA ADSO</footer>
        </main>
    </div>
</div>
<div id="toastHost" class="toast-host" aria-live="polite"></div>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
