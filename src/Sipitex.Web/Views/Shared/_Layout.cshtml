@using System.Security.Claims
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string NavClass(string name) => controller.Equals(name, StringComparison.OrdinalIgnoreCase) ? "nav-item active" : "nav-item";
    var title = ViewData["Title"]?.ToString() ?? "SIPITEX";
    var breadcrumb = ViewData["Breadcrumb"]?.ToString() ?? "SIPITEX";
    var user = User.Identity?.IsAuthenticated == true ? User : null;
    var role = user?.FindFirstValue(ClaimTypes.Role) ?? "Invitado";
    var name = user?.FindFirstValue(ClaimTypes.Name) ?? "Usuario";
    var photo = user?.FindFirstValue("photo");
    var toastMessage = TempData["Message"] as string;
    var toastSuccess = TempData["IsSuccess"] as bool?;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>SIPITEX · @title</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="~/css/sipitex.css" asp-append-version="true" />
</head>
<body>
<div class="shell">
    <div class="sidebar-backdrop" id="sidebarBackdrop" hidden></div>
    <aside class="sidebar" id="sidebar" aria-label="Navegación principal">
        <div class="sidebar-brand">
            <div class="mark">
                <div class="mark-icon">
                    <img src="~/img/logo-mark.svg" asp-append-version="true" alt="SIPITEX" />
                </div>
                <div><h1>SIPITEX</h1></div>
            </div>
            <button type="button" class="sidebar-close" id="sidebarClose" aria-label="Cerrar menú">
                <i class="fas fa-xmark"></i>
            </button>
            <p>Sistema Integrado de Aprendizaje, Producción<br>e Inventario Textil · SENA CMTC</p>
        </div>
        <nav class="nav-group">
            <div class="nav-group-label">Operación</div>
            <a class="@NavClass("Inventario")" asp-controller="Inventario" asp-action="Index"><i class="fas fa-boxes-stacked"></i> Inventario</a>
            <a class="@NavClass("Ordenes")" asp-controller="Ordenes" asp-action="Index"><i class="fas fa-clipboard-list"></i> Órdenes de producción</a>
            <a class="@NavClass("Mrp")" asp-controller="Mrp" asp-action="Index"><i class="fas fa-diagram-project"></i> MRP / Materiales</a>
            <a class="@NavClass("Fichas")" asp-controller="Fichas" asp-action="Index"><i class="fas fa-people-group"></i> Fichas & producción</a>
            <a class="@NavClass("Calidad")" asp-controller="Calidad" asp-action="Index"><i class="fas fa-clipboard-check"></i> Control de calidad</a>
        </nav>
        <nav class="nav-group">
            <div class="nav-group-label">Análisis</div>
            <a class="@NavClass("Estadisticas")" asp-controller="Estadisticas" asp-action="Index"><i class="fas fa-chart-line"></i> Estadísticas</a>
            <a class="@NavClass("Reportes")" asp-controller="Reportes" asp-action="Index"><i class="fas fa-file-export"></i> Reportes</a>
            <a class="@NavClass("Alertas")" asp-controller="Alertas" asp-action="Index"><i class="fas fa-bell"></i> Alertas</a>
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
            {
                <a class="@NavClass("Account")" asp-controller="Account" asp-action="Users"><i class="fas fa-users-gear"></i> Usuarios</a>
            }
        </nav>
        <div class="sidebar-foot">SIPITEX v1.0 · .NET MVC<br>SENA CMTC · ADSO</div>
    </aside>
    <div class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button type="button" class="menu-toggle" id="menuToggle" aria-label="Abrir menú" aria-controls="sidebar" aria-expanded="false"><i class="fas fa-bars"></i></button>
                <div class="topbar-title">
                    <h2>@title</h2>
                    <div class="breadcrumb">@breadcrumb</div>
                </div>
            </div>
            <div class="topbar-right">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="icon-btn" asp-controller="Alertas" asp-action="Index" title="Alertas" aria-label="Alertas">
                        <i class="fas fa-bell"></i>
                    </a>
                    <a class="role-chip role-chip-link" asp-controller="Account" asp-action="Profile" title="Mi perfil" aria-label="Ir a mi perfil">
                        @if (!string.IsNullOrWhiteSpace(photo))
                        {
                            <img class="avatar avatar-img" src="@photo" alt="" />
                        }
                        else
                        {
                            <div class="avatar">@(string.IsNullOrEmpty(name) ? "?" : name.Substring(0, 1).ToUpper())</div>
                        }
                        <span class="role-text">@name · @role</span>
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ghost small logout-btn"><i class="fas fa-right-from-bracket"></i> <span class="logout-label">Salir</span></button>
                    </form>
                }
                else
                {
                    <a class="btn primary small" asp-controller="Account" asp-action="Login"><i class="fas fa-right-to-bracket"></i> Entrar</a>
                }
            </div>
        </header>
        <main class="content">
            @if (!string.IsNullOrWhiteSpace(toastMessage))
            {
                <div data-toast data-toast-type="@(toastSuccess == false ? "danger" : "success")" class="visually-hidden" style="position:absolute;left:-9999px;">@toastMessage</div>
            }
            @RenderBody()
            <footer class="site-footer">SIPITEX — Sistema Integrado de Aprendizaje, Producción e Inventario Textil · SENA CMTC</footer>
        </main>
    </div>
</div>
<div id="toastHost" class="toast-host" aria-live="polite"></div>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
