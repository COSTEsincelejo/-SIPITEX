@model Sipitex.Web.Models.PagerModel
@using Microsoft.AspNetCore.Routing
@{
    var pages = Math.Max(1, Model.TotalPages);
    var extra = (Model.Extra ?? new Dictionary<string, string?>())
        .Where(pair => !string.IsNullOrEmpty(pair.Value))
        .ToDictionary(pair => pair.Key, pair => pair.Value!);

    RouteValueDictionary Values(int targetPage)
    {
        var values = new RouteValueDictionary();
        foreach (var pair in extra)
            values[pair.Key] = pair.Value;
        values["page"] = targetPage;
        return values;
    }

    var formAction = Url.Action(Model.Action, Model.Controller);
}
@if (Model.TotalCount > 0)
{
    <nav class="pager" aria-label="Paginación">
        @if (Model.Page > 1)
        {
            <a class="ghost small" href="@Url.Action(Model.Action, Model.Controller, Values(Model.Page - 1))">Anterior</a>
        }
        else
        {
            <span class="ghost small pager-disabled">Anterior</span>
        }
        <form method="get" action="@formAction" class="pager-jump">
            @foreach (var pair in extra)
            {
                <input type="hidden" name="@pair.Key" value="@pair.Value" />
            }
            <label class="pager-label" for="@Model.JumpInputId">Página</label>
            <input id="@Model.JumpInputId" type="number" name="page" min="1" max="@pages" value="@Model.Page" aria-label="Ir a la página" />
            <span class="pager-label">de @pages</span>
            <button type="submit" class="small ghost">Ir</button>
        </form>
        @if (Model.Page < pages)
        {
            <a class="ghost small" href="@Url.Action(Model.Action, Model.Controller, Values(Model.Page + 1))">Siguiente</a>
        }
        else
        {
            <span class="ghost small pager-disabled">Siguiente</span>
        }
        <span class="pager-label">@Model.TotalCount registro@(Model.TotalCount == 1 ? "" : "s")</span>
    </nav>
}
