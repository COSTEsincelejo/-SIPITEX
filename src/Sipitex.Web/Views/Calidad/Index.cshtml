@model CalidadIndexViewModel
@{
    ViewData["Title"] = "Control de calidad";
    ViewData["Breadcrumb"] = "SIPITEX / Operación / Control de calidad";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h2>Control de calidad</h2>
        <div class="sub">Registra inspecciones por orden y resultado</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div data-toast data-toast-type="@(Model.IsSuccess ? "success" : "danger")" style="position:absolute;left:-9999px;">@Model.Message</div>
}

<div class="card">
    <div class="card-title"><i class="fas fa-clipboard-check"></i> Evaluación de prendas</div>
    <form asp-action="Create" method="post" class="form-row" id="qualityForm">
        @Html.AntiForgeryToken()
        <div class="field">
            <label class="field-label">Orden</label>
            <select asp-for="Create.ProductionOrderId" asp-items="@(new SelectList(Model.Orders, "Id", "OrderNumber"))"></select>
        </div>
        <div class="field" style="width:160px;">
            <label class="field-label">Unidades revisadas</label>
            <input asp-for="Create.Units" type="number" min="1" required />
        </div>
        <div class="field">
            <label class="field-label">Resultado</label>
            <select asp-for="Create.Result" asp-items="Html.GetEnumSelectList<QualityResult>()" id="qualityResult"></select>
        </div>
        <div class="field reprocess-fields" style="flex:1;min-width:180px;">
            <label class="field-label">Motivo reproceso</label>
            <input asp-for="Create.MotivoReproceso" placeholder="Ej. costura irregular" />
        </div>
        <div class="field reprocess-fields" style="min-width:160px;">
            <label class="field-label">Responsable</label>
            <input asp-for="Create.Responsable" placeholder="Nombre" />
        </div>
        <button type="submit" class="primary"><i class="fas fa-plus"></i> Registrar inspección</button>
    </form>

    @if (!Model.Records.Any())
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-clipboard-check", Title = "Sin inspecciones", Text = "Aún no se han registrado evaluaciones de calidad.", ActionText = "Complete el formulario para registrar la primera inspección." }' />
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Orden</th><th>Unidades</th><th>Resultado</th><th>Motivo</th><th>Responsable</th><th>Fecha</th></tr></thead>
                <tbody>
                @foreach (var record in Model.Records)
                {
                    <tr>
                        <td>@record.OrderNumber</td>
                        <td>@record.Units</td>
                        <td><span class="badge @DisplayHelper.BadgeClass(record.Result)">@DisplayHelper.StatusText(record.Result)</span></td>
                        <td>@(record.MotivoReproceso ?? "—")</td>
                        <td>@(record.Responsable ?? "—")</td>
                        <td>@record.Date.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
<script>
    @* Muestra/oculta campos de reproceso según el resultado elegido *@
    (function () {
        const select = document.getElementById('qualityResult');
        const fields = document.querySelectorAll('.reprocess-fields');
        function sync() {
            const show = select && select.value === 'Reproceso';
            fields.forEach(el => el.style.display = show ? '' : 'none');
        }
        select?.addEventListener('change', sync);
        sync();
    })();
</script>
}
